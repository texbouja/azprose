%% azlayout.sty — géométrie, fontes et langue du kit azkit
%%
%% Ce module règle la SORTIE : format de papier, marges, fontes, langue. Il est
%% partagé par toutes les classes du kit — un devoir et un cours n'ont pas les
%% mêmes environnements, mais ils sortent sur le même papier.
%%
%% Deux ruptures avec cpgekit :
%%
%%  · les formats de papier passent par `paperwidth`/`paperheight`, l'interface
%%    publique de geometry, et non plus par \Gm@setsize et \define@key{Gm} ;
%%  · polyglossia est déclassé. xelatex sait désormais travailler avec babel,
%%    ce qui fait tomber du même coup ifluatex, ifxetex et pdftexcmds, chargés
%%    uniquement pour arbitrer entre les deux.
%%
%% Sadik Boujaida — licence LPPL 1.3c

\NeedsTeXFormat{LaTeX2e}[2022/06/01]
\ProvidesExplPackage {azlayout} {2026-08-20} {0.1}
  {azkit — géométrie, fontes et langue}

\RequirePackage { azbase }
\RequirePackage { geometry }
\RequirePackage { cuted }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Messages
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\msg_new:nnnn { azkit } { media-inconnu }
  { Support~de~sortie~«~#1~»~inconnu. }
  {
    Les~supports~connus~sont~:~print,~2print,~lsprint,~book,~altbook,~draft,~
    phone,~altphone,~beamer,~tablet,~lstablet,~alttablet,~lsalttablet.
  }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Drapeaux de mise en page
%%
%% Exposés en \if… classiques : ils sont lus par les fichiers de thème et par
%% le code hérité, qui sont du TeX ordinaire.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\cs_if_exist:NF \ifdark       { \newif \ifdark }
\cs_if_exist:NF \ifprint      { \newif \ifprint }
\cs_if_exist:NF \ifcompact    { \newif \ifcompact }
\cs_if_exist:NF \iflandscape  { \newif \iflandscape }
\cs_if_exist:NF \iftitlepage  { \newif \iftitlepage }
\cs_if_exist:NF \ifstriptitle { \newif \ifstriptitle }
\cs_if_exist:NF \ifdraft      { \newif \ifdraft }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Marge de note
%%
%% `littlemargin` n'existe pas dans geometry : c'est une commodité du kit, qui
%% règle d'un coup la largeur de la colonne de notes marginales et supprime
%% l'espace qui l'en sépare. Traitée ici, jamais transmise à geometry.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\dim_new:N \azlittlemargin

\cs_new_protected:Npn \az_littlemargin:n #1
  {
    \dim_set:Nn \azlittlemargin {#1}
    \dim_set:Nn \marginparwidth {#1}
    \dim_zero:N \marginparsep
  }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Supports de sortie
%%
%% Un support est une intention — « lu sur une tablette », « imprimé recto
%% verso » — pas un format de papier. Il fixe d'un coup le papier, les marges
%% et les drapeaux qui vont avec, parce que ces trois choses ne se décident pas
%% séparément : un écran de téléphone impose la compacité autant que sa taille.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\prop_new:N \g_az_media_prop

\cs_new_protected:Npn \az_media_new:nn #1#2
  { \prop_gput:Nnn \g_az_media_prop {#1} {#2} }

%% ── Impression ──────────────────────────────────────────────────────────────

\az_media_new:nn { print }
  {
    \printtrue \darkfalse \compactfalse
    \geometry
      {
        a4paper, inner = 3cm, outer = 2cm, vmargin = {3cm,3cm},
        headsep = 1.5cm, footskip = 2cm
      }
    \az_littlemargin:n { 6pc }
  }

\az_media_new:nn { 2print }
  {
    \printtrue \darkfalse \compacttrue \striptitletrue
    \geometry
      {
        a4paper, twocolumn, columnsep = 24truept,
        inner = 1truecm, outer = 1truecm, vmargin = {2.4truecm,2.4truecm},
        footskip = 1.6cm
      }
    \az_littlemargin:n { 4.5pc }
  }

\az_media_new:nn { lsprint }
