%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% \unite — l'unité de sens
%%
%% \unite ouvre une articulation à l'intérieur d'un théorème ou d'une
%% définition, sans que le rédacteur ouvre quoi que ce soit : c'est
%% l'environnement englobant qui a armé \unite avec \az_unite_first:.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\azdefcounter { unite } { |X|.|1| } (T)
\azgsetdeco { unite } { \bfseries #1. }
\azgsetdeco { unitetitle } { \textbf {#1~:~} }
\azgsetdeco { itemtitle } { \bfseries \boldmath #1. \enskip }
\azmakethetolabel* { unite }

\bool_new:N \l__az_unite_bool

\cs_new_protected:Npn \az_unite_env:
  {
    \int_zero:N \@enumdepth
    \exp_args:Nc \list { az@label@unite }
      {
        \usecounter { unite }
        \dim_zero:N \listparindent
        \dim_zero:N \labelwidth
        \dim_set_eq:NN \itemindent \labelsep
        \dim_zero:N \leftmargin
        \cs_set_eq:NN \makelabel \az_unite_label:n
      }
  }

\cs_new_protected:Npn \az_unite_label:n #1
  {
    \tl_if_blank:nTF {#1}
      { \hskip -\labelsep }
      { \azusedeco { unite } {#1} }
  }

\cs_new_protected:Npn \closeunite
  {
    \bool_if:NT \l__az_unite_bool
      {
        \endlist
        \cs_set_eq:NN \unite \relax
        \bool_set_false:N \l__az_unite_bool
      }
  }

\cs_new_protected:Npn \az_unite_first:
  {
    \bool_set_true:N \l__az_unite_bool
    \cs_set_eq:NN \unite \az_unite_item:w
