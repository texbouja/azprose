%% xenum et xitem
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\cs_new_protected:Npn \az_liste_savecounter:
  {
    \cs_gset:cpx { az@last@ \az@listctr }
      { \int_use:c { c@ \az@listctr } }
  }

\NewDocumentEnvironment { xenum } { e{\op} }
  {
    \tl_set:Nn \az@xlistenv { xenum }
    \int_compare:nTF { \@enumdepth > 2 } { \@toodeep }
      {
        \int_incr:N \@enumdepth
        \tl_set:Nx \az@listdepth { \int_use:N \@enumdepth }
        \tl_set:Nx \az@listlevel { \int_to_roman:n { \@enumdepth } }
        \tl_set:Nx \az@listctr  { enum \az@listlevel }
      }
    \az_liste_outerdeco_init:
    \IfValueT {#1} { \az_liste_options:n {#1} }
    \az_liste_builder:
    \bool_if:NT \l__az_resume_bool
      {
        \int_set:cn { c@ \az@listctr } { \use:c { az@last@ \az@listctr } }
        \bool_set_false:N \l__az_resume_bool
      }
  }
  { \az_liste_savecounter: \endlist }

%% Deux passes sur le même jeu d'options : la première ne retient que les clés
%% de préchargement (reprendre la numérotation, restaurer le réglage
%% précédent), la seconde applique le reste. Sans cette séparation, `restore`
%% arriverait après les réglages qu'il est censé remplacer.
\cs_new_protected:Npn \az_liste_options:n #1
  {
    \keys_set:nn { az / lists / preload } {#1}
    \bool_if:NF \l__az_save_bool
      {
        \cs_set_eq:NN \az_liste_savecounter: \prg_do_nothing:
        \cs_set_eq:NN \az_liste_save:n \use_none:n
      }
    \bool_if:NTF \l__az_restore_bool
      {
        \use:c { az@lastopts@ \az@listctr }
        \bool_set_false:N \l__az_restore_bool
      }
      {
        \clist_gclear:N \g__az_liste_opts_clist
        \azsetuplists {#1}
        \cs_gset:cpx { az@lastopts@ \az@listctr }
          {
            \exp_not:N \azsetuplists
              { \exp_not:V \g__az_liste_opts_clist }
          }
      }
  }

\NewDocumentEnvironment { xitem } { e{\op} }
  {
    \tl_set:Nn \az@xlistenv { xitem }
    \int_compare:nTF { \@itemdepth > 2 } { \@toodeep }
      {
        \int_incr:N \@itemdepth
        \tl_set:Nx \az@listdepth { \int_use:N \@itemdepth }
        \tl_set:Nx \az@listlevel { \int_to_roman:n { \@itemdepth } }
        \tl_set:Nx \az@listctr  { item \az@listlevel }
      }
    \IfValueT {#1} { \azsetuplists {#1} }
    \az_liste_builder_star:
  }
  { \endlist }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% \xit — l'articulation
%%
%%   \xit          élément du niveau courant
%%   \xit[3]       étiquette imposée
%%   \xit[3*]      la numérotation REPART de 3
%%   \xit[3+]      la numérotation AVANCE de 3
%%   \xit(titre)   élément titré
%%   \xit<clé>     élément référençable
%%   \xit- - -     remonte d'autant de niveaux avant de poser l'élément
%%
%% La liste s'ouvre toute seule au premier \xit : c'est le point du kit qui
%% dispense le rédacteur de \begin{enumerate}.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\NewDocumentCommand \az_liste_init:nn { m m !t\r !t+ !E{\op}{{}} }
  {
    \bool_set_false:N \l__az_init_bool
    \IfBooleanTF {#3}
      { \tl_set:Nn \l__az_init_tl { \begin {#1} \op { r, #5 } }
        \bool_set_true:N \l__az_init_bool }
      {
        \IfBooleanTF {#4}
          { \tl_set:Nn \l__az_init_tl { \begin {#1} \op {#5} }
            \bool_set_true:N \l__az_init_bool }
          {
            \tl_if_empty:NT \az@xlistenv
              { \tl_set:Nn \l__az_init_tl { \begin {#1} \op {#5} }
                \bool_set_true:N \l__az_init_bool }
          }
      }
    \bool_if:NF \l__az_init_bool
      {
        \tl_if_blank:nF {#5}
          { \tl_set:Nn \l__az_init_tl { \begin {#1} \op {#5} }
            \bool_set_true:N \l__az_init_bool }
      }
    \bool_if:NT \l__az_init_bool { \l__az_init_tl }
    #2
  }

\bool_new:N \l__az_init_bool
\tl_new:N   \l__az_init_tl

%% Suffixe d'étiquette : `*` repart du numéro donné, `+` l'ajoute au courant.
\cs_new_protected:Npn \az_liste_label:n #1
  {
    \str_case_e:nnF { \tl_item:nn {#1} {-1} }
      {
        { * } { \tl_set:Nx \l__az_liste_tmp_tl
                  { \int_eval:n { \az_liste_sansfin:n {#1} - 1 } }
                \az_setcounter_ref:VV \az@listctr \l__az_liste_tmp_tl \item }
        { + } { \tl_set:Nx \l__az_liste_tmp_tl
                  { \int_eval:n { \az_liste_sansfin:n {#1} - 1 } }
                \az_addtocounter_ref:VV \az@listctr \l__az_liste_tmp_tl \item }
      }
      { \item [#1] }
  }

\cs_generate_variant:Nn \az_setcounter_ref:nn { VV }
\cs_generate_variant:Nn \az_addtocounter_ref:nn { VV }
\tl_new:N \l__az_liste_tmp_tl

\cs_new:Npn \az_liste_sansfin:n #1
  { \tl_range:nnn {#1} {1} {-2} }

\NewDocumentCommand \az_liste_xit_enum:w { !t- !t- !t- !o !d() !d<> }
  {
    \az_liste_remonte:nnn {#1} {#2} {#3}
    \IfValueTF {#4} { \az_liste_label:n {#4} } { \item }
    \IfValueT {#5}
      { \azusedeco { itemtitle } {#5}
        \tl_set:Nx \@currentlabelname { \exp_not:n {#5} } }
    \IfValueT {#6} { \label { \az@enumlabelprefix #6 } }
  }

\NewDocumentCommand \az_liste_xit_item:w { !t- !t- !t- !o !d() !d<> }
  {
    \az_liste_remonte:nnn {#1} {#2} {#3}
    \IfValueTF {#4}
      { \item [ \use:c { az@deco@ \az@listctr } {#4} ] }
      { \item }
    \IfValueT {#5} { \azusedeco { itemtitle } {#5} }
    \IfValueT {#6}
      {
        \phantomsection
        \tl_set:Nx \@currentlabelname { \exp_not:n {#5} }
        \label { \az@enumlabelprefix #6 }
      }
  }

\NewDocumentCommand \az_liste_xit_tab:w { !o !d() !d<> }
  {
    \tabitem
    \IfValueT {#2} { \azusedeco { itemtitle } {#2} }
    \IfValueT {#3} { \label { \az@enumlabelprefix #3 } }
  }

\NewDocumentCommand \az_liste_remonte:nnn { m m m }
  {
    \IfBooleanT {#1}
      { \exit -
        \IfBooleanT {#2}
          { \exit -
            \IfBooleanT {#3} { \exit - } } }
  }

\NewDocumentCommand \xitenum { } { \az_liste_init:nn { xenum } { \az_liste_xit_enum:w } }
\NewDocumentCommand \xititem { } { \az_liste_init:nn { xitem } { \az_liste_xit_item:w } }
\NewDocumentCommand \xittab  { } { \az_liste_init:nn { tabenum } { \az_liste_xit_tab:w } }

\NewDocumentCommand \xit { t\i t\t }
  {
    \IfBooleanTF {#1}
      { \xititem + }
      { \IfBooleanTF {#2} { \xittab + } { \xitenum } }
  }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% \exit — fermer ce qui reste ouvert
%%
%% Sans étoile ni tiret, \exit ferme TOUTE la pile de listes du bloc courant.
%% Un tiret par niveau à remonter quand on veut n'en fermer qu'une partie.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\cs_new_protected:Npn \az_liste_end:
  {
    \tl_if_empty:NF \az@xlistenv
      { \use:x { \exp_not:N \end { \az@xlistenv } } }
  }

\cs_new_protected:Npn \az_liste_end_rec:
  {
    \tl_if_empty:NF \az@xlistenv
      {
        \use:x { \exp_not:N \end { \az@xlistenv } }
        \az_liste_end_rec:
      }
  }

\NewDocumentCommand \exit { !t- !t- !t- !t- }
  {
    \IfBooleanTF {#1}
      {
        \az_liste_end:
        \IfBooleanT {#2}
          { \az_liste_end:
            \IfBooleanT {#3}
              { \az_liste_end:
                \IfBooleanT {#4} { \az_liste_end: } } }
      }
      { \az_liste_end_rec: }
  }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Créateur de listes
%%
%%   \aznewlist{cas}{\cas}{n=|1|, d=\textit{cas #1.}}
%%
%% L'étoile produit une liste NON numérotée (famille xitem).
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%% Les options sont RANGÉES et non recopiées dans le corps de l'environnement :
%% elles contiennent presque toujours un `d=…#1…`, et un #1 déposé tel quel
%% dans un corps de définition y désignerait l'argument de l'ENVIRONNEMENT.
\cs_new_protected:Npn \az_newlist_open:nnn #1#2#3
  % #1 = xenum|xitem, #2 = nom de la liste, #3 = options en ligne
  {
    \use:x
      {
        \exp_not:c {#1} \exp_not:N \op
          { \exp_not:v { az@newlist@opts@ #2 } , \exp_not:n {#3} }
      }
    \tl_set:Nn \az@xlistenv {#2}
  }

\NewDocumentCommand \aznewlist { s m m m }
  {
    \tl_gset:cn { az@newlist@opts@ #2 } {#4}
    \IfBooleanTF {#1}
      {
        \NewDocumentEnvironment {#2} { E{\op}{{}} }
          { \az_newlist_open:nnn { xitem } {#2} {##1} }
          { \endlist }
        \cs_set_protected:Npn #3 { \az_liste_init:nn {#2} { \az_liste_xit_item:w } }
      }
      {
        \NewDocumentEnvironment {#2} { E{\op}{{}} }
          { \az_newlist_open:nnn { xenum } {#2} {##1} }
          { \az_liste_savecounter: \endlist }
        \cs_set_protected:Npn #3 { \az_liste_init:nn {#2} { \az_liste_xit_enum:w } }
      }
  }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% tabenum — des éléments courts en colonnes
%%
%% Utile pour une série de calculs à répondre : la liste se répartit en
%% colonnes dont la largeur s'ajuste au plus large élément rencontré.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\dim_new:N \l__az_tab_label_dim
\dim_new:N \l__az_tab_line_dim
\dim_new:N \l__az_tab_col_dim
\dim_new:N \l__az_tab_width_dim
\bool_new:N \l__az_tab_field_bool
\tl_new:N \az@tabenum
\tl_new:N \az@numtab

\cs_new_protected:Npn \az_tab_addfield:
  {
    \@stopfield
    \dim_compare:nF
      { \l__az_tab_line_dim > \box_wd:N \@curfield + \box_wd:N \@curline }
      { \az_tab_output: }
    \dim_zero:N \l__az_tab_width_dim
    \bool_while_do:nn { \dim_compare_p:n { \l__az_tab_width_dim < \box_wd:N \@curfield } }
      { \dim_add:Nn \l__az_tab_width_dim { \l__az_tab_col_dim } }
    \az_tab_addline:
  }

\cs_new_protected:Npn \az_tab_output:
  {
    \hbox_set:Nn \@curline { \strut \unhbox \@curline \unskip \unskip \unskip }
    \noindent \box \@curline \par
  }

\cs_new_protected:Npn \az_tab_addline:
  {
    \hbox_set:Nn \@curline
      {
        \box \@curline
        \copy \@curfield
        \hskip \dim_eval:n { \l__az_tab_width_dim - \box_wd:N \@curfield }
      }
  }

\cs_new_protected:Npn \az_tab_setup:
  {
    \hbox_set:Nn \l__az_liste_box
      {
        \int_set:cn { c@ \az@tabenum } {13}
        \azusedeco { tabenum } { \use:c { az@label@ \az@tabenum } }
      }
    \dim_set:Nn \l__az_tab_label_dim { \box_wd:N \l__az_liste_box }
    \dim_set:Nn \l__az_tab_line_dim { \columnwidth - \@totalleftmargin }
    \dim_set:Nn \l__az_tab_col_dim { \l__az_tab_line_dim / \az@numtab }
    \dim_set:Nn \l__az_tab_line_dim { \l__az_tab_col_dim * \az@numtab }
  }

\NewDocumentCommand \tabitem { }
  {
    \refstepcounter { \az@tabenum }
    \bool_if:NT \l__az_tab_field_bool { \az_tab_addfield: }
    \@startfield \bool_set_true:N \l__az_tab_field_bool
    \hbox to \l__az_tab_label_dim
      { \azusedeco { tabenum } { \use:c { az@label@ \az@tabenum } } \hss }
    \hskip \labelsep \relax
  }

\azgsetdeco { tabenum } { \bfseries #1. }

\keys_define:nn { az / lists / tabenum }
  {
    s .code:n = { \dim_set:Nn \parskip {#1} } ,
    s .default:n = { 0pt } ,
    n .code:n = { \az_liste_setlabel:Vn \az@tabenum {#1} } ,
    d .code:n = { \azsetdeco* { tabenum } {#1} } ,
    %% Deux nombres : le premier pour un document compact, le second sinon.
    columns .code:n = { \az_tab_columns:w #1 \q_stop } ,
    columns .default:n = { {2}{3} } ,
    c .code:n = { \az_tab_columns:w #1 \q_stop } ,
    unknown .code:n = { } ,
  }

\cs_new_protected:Npn \az_tab_columns:w #1#2 \q_stop
  { \tl_set:Nx \az@numtab { \ifcompact #1 \else #2 \fi } }

\NewDocumentCommand \azsetuptabenum { m }
  { \keys_set:nn { az / lists / tabenum } {#1} }

\NewDocumentEnvironment { tabenum } { E{\op}{{}} }
  {
    \int_incr:N \@enumdepth
    \tl_set:Nx \az@listdepth { \int_use:N \@enumdepth }
    \tl_set:Nx \az@listlevel { \int_to_roman:n { \@enumdepth } }
    \tl_set:Nx \az@listctr  { enum \az@listlevel }
    \tl_set_eq:NN \az@tabenum \az@listctr
    \tl_set:Nn \az@xlistenv { tabenum }
    \skip_zero:N \partopsep \skip_zero:N \topsep
    \dim_set:Nn \labelsep { .33em }
    \cs_set:Npn \\ { \intertab { } }
    \azsetuptabenum { columns, #1 }
    \az_tab_setup:
    \int_zero:c { c@ \az@tabenum }
    \trivlist \item [ ]
    \cs_set_eq:NN \item \tabitem
  }
  {
    \bool_if:NT \l__az_tab_field_bool
      { \az_tab_addfield: \noindent \unhbox \@curline }
    \endtrivlist
  }

\NewDocumentCommand \intertab { +m }
  {
    \az_tab_addfield:
    \dim_compare:nF { \box_wd:N \@curline = 0pt } { \az_tab_output: }
