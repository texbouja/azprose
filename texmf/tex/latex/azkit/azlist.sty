    \IfValueT {#2} { \azusedeco { unitetitle } {#2} }
    \IfValueT {#3} { \IfValueF {#1} { \label {#3} } }
  }

\cs_new_protected:Npn \az_liste_unitelabel:n #1
  {
    \str_case_e:nnF { \tl_item:nn {#1} {-1} }
      {
        { * } { \exp_args:Nnx \az_setcounter_ref:nn { unite }
                  { \int_eval:n { \az_liste_sansfin:n {#1} - 1 } } \item }
        { + } { \exp_args:Nnx \az_addtocounter_ref:nn { unite }
                  { \int_eval:n { \az_liste_sansfin:n {#1} - 1 } } \item }
        %% (les deux branches ci-dessus partagent la forme de \az_liste_label:n)
      }
      { \item [#1] }
