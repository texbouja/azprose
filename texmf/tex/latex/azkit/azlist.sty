%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\DeclareFontFamily { U } { FdSymbolA } { }
\DeclareFontShape  { U } { FdSymbolA } { m } { n } { <-> s * [1] FdSymbolA-Book } { }
\DeclareFontShape  { U } { FdSymbolA } { m } { b } { <-> s * [1] FdSymbolA-Medium } { }
\DeclareSymbolFont { fdsymbols } { U } { FdSymbolA } { m } { n }
\SetSymbolFont     { fdsymbols } { bold } { U } { FdSymbolA } { m } { b }

\cs_new_protected:Npn \az_symbol_new:nn #1#2
  { \exp_args:Nc \DeclareMathSymbol {#1} { \mathord } { fdsymbols } {#2} }

\clist_map_inline:nn
  {
    { xdottriangleright } {9} , { xdottriangleup } {10} ,
    { xdottriangleleft } {11} , { xdottriangledown } {12} ,
    { xdotsquare } {13} ,
    { xtrianglerightL } {86} , { xtriangleupL } {87} ,
    { xtriangleleftL } {88} , { xtriangledownL } {89} ,
    { xtriangleright } {90} , { xtriangleup } {91} ,
    { xtriangleleft } {92} , { xtriangledown } {93} ,
    { xcircle } {98} , { xbullet } {99} ,
    { xsquareL } {117} , { xsquare } {118} ,
