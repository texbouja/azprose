    \azsetlabel { enumiii } { |i| }
    \azsetenum* {1} { marge*=0pt }
    \azsetenum* {2} { marge*=1pc }
    \azsetenum* {3} { marge*=2pc }
    \cs_set_eq:NN \unite \az_unite_first:
  }

\cs_new_eq:NN \unite \az_unite_first:

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% discussion — la disjonction de cas
%%
%% Un raisonnement par cas a une forme propre : « Si … : », « Cas où … : »,
%% « Supposons que … : ». L'environnement les fournit toutes, alignées sur une
%% même marge, pour que la structure logique se voie sans être décrite.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\NewDocumentCommand \az_disc_unite:nn { m m d() }
  { \IfValueTF {#3} { \item [ #1 #3 #2 ] } { \item } }

\NewDocumentCommand \az_disc_supp:w { s }
  {
    \IfBooleanTF {#1}
      { \az_disc_unite:nn { Supposons~qu' } { ~:~ } }
      { \az_disc_unite:nn { Supposons~que~ } { ~:~ } }
  }

\azgsetdeco { discuss } { $\bullet\;$ \bfseries \boldmath #1 }

\cs_new_protected:Npn \az_disc_label:n #1
  {
    \hskip \labelsep
    \tl_if_blank:nTF {#1}
      { \makebox [ \leftmargin - \labelsep ] [l] { \azusedeco {discuss} { } } }
      { \azusedeco {discuss} {#1} \hfil }
  }

\NewDocumentEnvironment { discussion } { e{\wd} }
  {
    \cs_set:Npn \unite { \az_disc_unite:nn { } { ~:~ } }
    \cs_set:Npn \si    { \az_disc_unite:nn { Si~ } { ~:~ } }
    \cs_set:Npn \cas   { \az_disc_unite:nn { Cas~où~ } { ~:~ } }
    \cs_set_eq:NN \supp \az_disc_supp:w
    \cs_set:Npn \imp ##1##2 { \item [ $##1 \Rightarrow ##2 \,)$ ] }
    \cs_set:Npn \equ ##1##2 { \item [ $##1 \Leftrightarrow ##2 \,)$ ] }
    \cs_set:Npn \cs { \item [ $\Leftarrow\,)$ ] }
    \cs_set:Npn \cn { \item [ $\Rightarrow\,)$ ] }
    \list { }
      {
        \IfNoValueTF {#1}
          {
            \dim_zero:N \labelwidth
            \dim_set:Nn \leftmargin {1pc}
            \dim_set:Nn \itemindent {-\leftmargin}
          }
          {
            \settowidth \leftmargin {#1}
            \dim_add:Nn \leftmargin { \labelsep }
            \dim_set_eq:NN \labelwidth \leftmargin
            \dim_zero:N \itemindent
          }
        \cs_set_eq:NN \makelabel \az_disc_label:n
      }
  }
  { \endlist }

\cs_new_eq:NN \disc \discussion
\cs_new_eq:NN \enddisc \enddiscussion

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Conditions et conséquences
%%
%% `cond` et `cons` seuls composent un tableau à deux colonnes : la condition à
%% gauche, ce qui la suit à droite. `condcons` les enveloppe et MESURE les
%% deux colonnes latérales avant de composer, pour que toutes les lignes du
%% bloc s'alignent — ce qu'un tableau ligne à ligne ne saurait faire.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\dim_new:N \ccleftmargin
\dim_new:N \ccrightmargin
\dim_new:N \ccsymbolwidth
\dim_new:N \l__az_cc_left_max_dim
\dim_new:N \l__az_cc_right_max_dim
\tl_new:N  \ccjot
\tl_set:Nn \ccjot { 3pt }
\bool_new:N \l__az_cc_intab_bool
\bool_new:N \l__az_cc_vline_bool

\cs_new:Npn \ccsi     { \relsize{-2} $\xbullet\;$ }
\cs_new:Npn \ccalors  { \relsize{-2} $\xdiamond\;$ }
\cs_new:Npn \ccneutre { \relsize{-2} $\xbullet$ }
\cs_new:Npn \blneutre { \relsize{-2} $\xsquare\;$ }

\AddToHook { begindocument/before }
  { \settowidth \ccleftmargin { Si } }

\DeclareDocumentEnvironment { cond } { O{\ccleftmargin} O{l} }
  {
    \ifhmode \par \else \leavevmode \fi
    \dim_set:Nn \extrarowheight {3pt}
    \tabular [t] { @{} p{#1} @{\ccsi\enspace} #2 @{} }
  }
  { \endtabular \par \smallskip }

\DeclareDocumentEnvironment { cons } { O{\ccleftmargin} O{l} }
  {
    \ifhmode \par \else \leavevmode \fi
    \dim_set:Nn \extrarowheight {3pt}
    \tabular [t] { @{} p{#1} @{\ccalors\enspace} #2 @{} }
  }
  { \endtabular \par \smallskip }

\DeclareDocumentEnvironment { stab } { O{2cm} O{l} }
  {
    \dim_set:Nn \extrarowheight {3pt}
    \tabular [t] { @{} p{#1} #2 @{} }
  }
  { \endtabular \par \smallskip }

\NewDocumentCommand \az_cc_line:w { D(){\ccneutre} s o m o }
  {
    \az_cc_init:
    \IfValueT {#3} {#3} & #1 \enskip \null & #4 & \IfValueT {#5} {#5}
    \IfBooleanF {#2} { \cr }
  }

\cs_new_protected:Npn \az_cc_init:
  {
    \bool_if:NF \l__az_cc_intab_bool
      {
        \bool_if:NTF \l__az_cc_vline_bool
          { \az_cc_opentab:n { | } }
          { \az_cc_opentab:n { } }
      }
  }

\cs_new_protected:Npn \az_cc_opentab:n #1
  {
    \ifhmode \hfill \par \fi
    \addvspace { \smallskipamount }
    \bool_set_true:N \l__az_cc_intab_bool
    \use:c { tabular* } { \linewidth - \@totalleftmargin } [t]
      {
        @{} p{\ccleftmargin} #1 r@{}
        p{
            \linewidth - \ccleftmargin - \ccrightmargin - \ccsymbolwidth
            - 2\tabcolsep - \fboxrule
          } @{}
        p{\ccrightmargin} @{}
      }
  }

\cs_new_protected:Npn \az_cc_close:
  {
    \bool_if:NT \l__az_cc_intab_bool
      {
        \use:c { endtabular* } \par \addvspace { \medskipamount }
        \bool_set_false:N \l__az_cc_intab_bool
      }
  }

%% Passe de MESURE : le corps est composé dans une boîte jetée, uniquement pour
%% relever la largeur des colonnes latérales. C'est le prix de l'alignement.
\cs_new_protected:Npn \az_cc_measure_symbol:n #1
  {
    \hbox_set:Nn \l__az_liste_box { #1 \enskip }
    \dim_compare:nT { \box_wd:N \l__az_liste_box > \ccsymbolwidth }
      { \dim_gset:Nn \ccsymbolwidth { \box_wd:N \l__az_liste_box } }
  }

\NewDocumentCommand \az_cc_measure:w { d() s o m o }
  {
    \IfValueT {#3}
      {
        \hbox_set:Nn \l__az_liste_box {#3}
        \dim_compare:nT { \box_wd:N \l__az_liste_box > \ccleftmargin }
          { \dim_gset:Nn \ccleftmargin { \box_wd:N \l__az_liste_box } }
      }
    \IfValueT {#5}
      {
        \hbox_set:Nn \l__az_liste_box {#5}
        \dim_compare:nT { \box_wd:N \l__az_liste_box > \ccrightmargin }
          { \dim_gset:Nn \ccrightmargin { \box_wd:N \l__az_liste_box } }
      }
    \IfValueT {#1} { \az_cc_measure_symbol:n {#1} }
  }

\cs_new_protected:Npn \az_cc_measure_body:n #1
  {
    \@bsphack
      \settowidth \ccsymbolwidth { \ccsi \enskip \null }
      \dim_zero:N \ccleftmargin
      \dim_zero:N \ccrightmargin
      \cs_set_eq:NN \cond \az_cc_measure:w
      \cs_set_eq:NN \cons \az_cc_measure:w
      \cs_set:Npn \linetab { \@ifnextchar ( \az_cc_measure:w { \az_cc_measure:w (\ccneutre) } }
      \cs_set_eq:NN \breaktab \relax
      \cs_set:Npn \notab ##1 { }
      \vbox_set:Nn \l__az_liste_box { \everypar { } #1 }
    \@esphack
  }

\keys_define:nn { az / condcons }
  {
    l .code:n = { \dim_set:Nn \l__az_cc_left_max_dim {#1} } ,
    r .code:n = { \dim_set:Nn \l__az_cc_right_max_dim {#1} } ,
    s .code:n = { \tl_set:Nn \ccjot {#1} } ,
    s .default:n = { 3pt } ,
    f .bool_set:N = \l__az_cc_vline_bool ,
  }

\NewDocumentEnvironment { condcons } { O{} +b }
  {
    \dim_set:Nn \l__az_cc_left_max_dim  { .28\linewidth }
    \dim_set:Nn \l__az_cc_right_max_dim { .17\linewidth }
    \az_cc_measure_symbol:n { \ccsi }
    \az_cc_measure_symbol:n { \ccalors }
    \keys_set:nn { az / condcons } {#1}
    \az_cc_measure_body:n {#2}
    \dim_compare:nT { \ccleftmargin > \l__az_cc_left_max_dim }
      { \dim_set_eq:NN \ccleftmargin \l__az_cc_left_max_dim }
    \dim_compare:nT { \ccrightmargin > \l__az_cc_right_max_dim }
      { \dim_set_eq:NN \ccrightmargin \l__az_cc_right_max_dim }
    \dim_set:Nn \extrarowheight { \ccjot }
    \everymath { \displaystyle }
    \cs_set_eq:NN \breaktab \az_cc_break:
    \cs_set_eq:NN \notab \az_cc_notab:n
    \cs_set:Npn \linetab { \az_cc_first:nn { linetab } { \ccneutre } }
    \cs_set:Npn \cond    { \az_cc_first:nn { cond }    { \ccsi } }
    \cs_set:Npn \cons    { \az_cc_first:nn { cons }    { \ccalors } }
    #2
    \az_cc_close:
  }
  { }

%% La PREMIÈRE occurrence ferme un tableau resté ouvert puis se redéfinit :
%% les suivantes entrent directement dans le tableau courant.
\cs_new_protected:Npn \az_cc_first:nn #1#2
  {
    \az_cc_close:
    \str_if_eq:nnTF {#1} { linetab }
      { \cs_set_eq:NN \linetab \az_cc_line:w }
      { \cs_set:cpn {#1} { \az_cc_line:w (#2) } }
    \use:c {#1}
  }

\cs_new_protected:Npn \az_cc_break:
  {
    \az_cc_close:
    \bool_if:NTF \l__az_cc_vline_bool
      { \az_cc_opentab:n { | } } { \az_cc_opentab:n { } }
  }

\cs_new_protected:Npn \az_cc_notab:n #1 { \az_cc_close: #1 }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% lrmargin et mini
%%
%% `mini` est le commentaire en retrait : une note, une démonstration, une
%% indication. Le nom du bloc sert d'étiquette (« n.b », « dem », « solution »)
%% et le contenu est composé plus serré, en corps réduit.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\skip_new:N \mini@skip
\dim_new:N  \lrmarginleft
\dim_new:N  \lrmarginright
\tl_new:N   \mini@font
\tl_new:N   \mini@label@font
\tl_new:N   \mini@punct
\bool_new:N \insidemini

\azgsetdeco { lrmargin } { \textbf {#1} }

\cs_new_protected:Npn \az_lrmargin_label:n #1
  {
    \tl_if_blank:nF {#1}
      { \azusedeco { lrmargin } { #1 \mini@punct } }
  }

\NewDocumentEnvironment { lrmargin } { O{} m m }
  {
    \ifhmode \@par \fi
    \list \relax
      {
        \skip_set:Nn \topsep { \smallskipamount }
        \skip_add:Nn \topsep { \mini@skip }
        \dim_set_eq:NN \listparindent \parindent
        \skip_set_eq:NN \parsep \parskip
        \dim_zero:N \itemindent
        \dim_zero:N \labelwidth
        \dim_set_eq:NN \itemindent \labelsep
        \int_compare:nTF { \@listdepth > 3 }
          { \dim_zero:N \leftmargin \dim_zero:N \rightmargin }
          {
            \tl_if_blank:nTF {#2} { \dim_zero:N \leftmargin }
              { \dim_set:Nn \leftmargin {#2} }
            \tl_if_blank:nTF {#3} { \dim_zero:N \rightmargin }
              { \dim_set:Nn \rightmargin {#3} }
          }
        \cs_set_eq:NN \makelabel \az_lrmargin_label:n
      }
    \item [#1] \ignorespaces
    \az_liste_defaults_inside:
  }
  { \closeunite \endlist }

\keys_define:nn { az / mini }
  {
    before~skip  .code:n = { \skip_set:Nn \mini@skip {#1} } ,
    beforeskip   .meta:n = { before~skip = #1 } ,
    left~margin  .code:n = { \dim_set:Nn \lrmarginleft {#1} } ,
    right~margin .code:n = { \dim_set:Nn \lrmarginright {#1} } ,
    lm .meta:n = { left~margin = #1 } ,
    rm .meta:n = { right~margin = #1 } ,
    font       .code:n = { \tl_set:Nn \mini@font {#1} } ,
    label~font .code:n = { \tl_set:Nn \mini@label@font { #1 \vphantom{(} } } ,
    punct      .code:n = { \tl_set:Nn \mini@punct {#1} } ,
    deco       .code:n = { \azsetdeco { lrmargin } { \mini@label@font #1 } } ,
  }

\keys_set:nn { az / mini }
  {
    font = \sffamily \small ,
    label~font = \sffamily \small \scshape \bfseries ,
    punct = . ,
    deco = #1 ,
  }

\keys_define:nn { az / minitem }
  {
    label~font .code:n = { \tl_set:Nn \mini@label@font { #1 \vphantom{(} } } ,
    punct      .code:n = { \tl_set:Nn \mini@punct {#1} } ,
    unknown    .code:n = { } ,
  }

\tl_new:N \g_az_minitem_font_tl
\tl_new:N \g_az_minitem_punct_tl
\tl_gset:Nn \g_az_minitem_font_tl { \sffamily \small \scshape \bfseries }
\tl_gset:Nn \g_az_minitem_punct_tl { . }

\NewDocumentCommand \az_mini_item:w { O{} m d() }
  {
    \keys_set:nn { az / minitem } {#1}
    \item [ \MakeLowercase {#2} \IfValueT {#3} { ~:~#3 } ]
    %% Les réglages d'un \minitem ne valent que pour LUI : la valeur d'usine
    %% revient aussitôt, sinon le premier élément habillé contaminerait tous
    %% les suivants du même bloc.
    \tl_set_eq:NN \mini@label@font \g_az_minitem_font_tl
    \tl_set_eq:NN \mini@punct \g_az_minitem_punct_tl
  }

\NewDocumentEnvironment { mini } { O{} m d() }
  {
    \keys_set:nn { az / mini } {#1}
    \dim_compare:nT { \@totalleftmargin > 3.4em } { \dim_zero:N \lrmarginleft }
    \cs_set_eq:NN \minitem \az_mini_item:w
    \mini@font
    \ifhmode \@par \fi
    \begin { lrmargin }
      [ \MakeLowercase {#2} \IfValueT {#3} { ~:~#3 } ]
      { \lrmarginleft } { }
    \ignorespaces
    \bool_set_true:N \insidemini
  }
  { \end { lrmargin } }

%% Les blocs courants, nommés par ce qu'ils sont.
\NewDocumentCommand \aznewmini { m m }
  {
    \cs_gset_protected:cpn {#1} { \begin {mini} {#2} }
    \cs_gset_protected:cpn { end #1 } { \end {mini} }
  }

\aznewmini {nb}   {n.b}
\aznewmini {dem}  {dem}
\aznewmini {sol}  {solution}
\aznewmini {ind}  {indication}
\aznewmini {synt} {synthèse}

