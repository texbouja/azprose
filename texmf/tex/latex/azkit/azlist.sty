%% azlist.sty — le système de listes du kit azkit
%%
%% C'est la plus grosse surface d'écriture du kit : \unite, \xit et \exit sont,
%% de loin, les commandes les plus employées du corpus. Tout y tourne autour
%% d'une idée : le rédacteur DÉCLARE une articulation — une unité de sens, un
%% cas, une condition — et ne s'occupe jamais d'ouvrir ni de fermer un
%% environnement de liste. \xit ouvre ce qu'il faut, \exit referme ce qui reste.
%%
%% Trois étages :
%%
%%   · les GABARITS d'étiquette et les DÉCORATIONS viennent de azbase ;
%%   · les PROPRIÉTÉS d'espacement (marge, saut, alignement) sont accumulées
%%     par niveau, et consommées seulement quand une liste s'ouvre ;
%%   · les ENVIRONNEMENTS (xenum, xitem, tabenum, mini, condcons) s'appuient
%%     sur les deux précédents.
%%
%% Les propriétés sont différées parce que la largeur d'étiquette ne peut être
%% mesurée qu'avec la fonte courante, laquelle n'est connue qu'au moment où la
%% liste commence — jamais au moment où on la règle.
%%
%% Sadik Boujaida — licence LPPL 1.3c

\NeedsTeXFormat{LaTeX2e}[2022/06/01]
\ProvidesExplPackage {azlist} {2026-08-20} {0.1}
  {azkit — listes, unités, discussions et tableaux d'articulation}

\RequirePackage { azbase }
\RequirePackage { array }
\RequirePackage { relsize }

%% azlist se charge seul aussi bien qu'au sein d'une classe du kit : le drapeau
%% de compacité est déclaré ici s'il ne l'a pas déjà été, faute de quoi
%% `tabenum` ne saurait pas combien de colonnes composer.
\cs_if_exist:NF \ifcompact { \newif \ifcompact }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Messages et registres
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\msg_new:nnnn { azkit } { liste-hors-contexte }
  { «~#1~»~n'est~pas~réglable~depuis~\string\azsetuplists. }
  {
    Cette~clé~ne~vaut~que~pour~une~liste~EN~COURS.~Hors~liste,~passer~par~une~
    famille~de~niveau~:~\string\azsetuplists{enumi={…}}.
  }

\box_new:N   \l__az_liste_box
\dim_new:N   \l__az_liste_dim
\skip_new:N  \l__az_liste_skip
\dim_new:N   \az@maxlabelwidth
\dim_new:N   \az@labelwidth
\tl_new:N    \az@listctr
\tl_new:N    \az@listlevel
\tl_new:N    \az@listdepth
\tl_new:N    \az@xlistenv
\tl_new:N    \az@enumlabelprefix
\clist_new:N \g__az_liste_opts_clist

\bool_new:N \l__az_resume_bool
\bool_new:N \l__az_restore_bool
\bool_new:N \l__az_save_bool
\bool_set_true:N \l__az_save_bool

%% Les dimensions d'origine de la classe : les clés d'espacement s'y réfèrent
%% quand on leur demande « la valeur normale » plutôt qu'une valeur explicite.
\skip_new:N \az@topsep@origin
\skip_new:N \az@itemsep@origin
\AddToHook { begindocument/before }
  {
    \skip_set:Nn \az@topsep@origin  { \topsep }
    \skip_set:Nn \az@itemsep@origin { \itemsep }
  }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% \item sans étiquette
%%
%% Copie du \@item du noyau, à deux gardes près : une étiquette VIDE ne doit
%% produire ni numéro ni espacement vertical. C'est ce qui permet à \unite
%% d'ouvrir une articulation sans marque visible, et à \xit d'enchaîner des
%% éléments serrés là où le noyau imposerait un \itemsep.
%%
%% Restée en TeX du noyau, délibérément : c'est une variante d'une routine de
%% latex.ltx, et la faire ressembler à autre chose la rendrait plus difficile à
%% comparer à son original le jour où le noyau bougera.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\cs_new_protected:Npn \az@item
  {
    \@inmatherr \item
    \@ifnextchar [ \az@item@ques { \@noitemargtrue \az@item@ques [\@itemlabel] }
  }

\cs_new_protected:Npn \az@item@ques [#1]
  {
    \@hyper@itemtrue
    \if@noparitem
      \@donoparitem
    \else
      \if@inlabel \indent \par \fi
      \ifhmode \unskip \unskip \par \fi
      \if@newlist
        \if@nobreak
          \@nbitem
        \else
          \addpenalty \@beginparpenalty
          \tl_if_blank:nF {#1} { \addvspace \@topsep \addvspace {-\parskip} }
        \fi
      \else
        \addpenalty \@itempenalty
        \tl_if_blank:nF {#1} { \addvspace \itemsep }
      \fi
      \global \@inlabeltrue
    \fi
    \everypar
      {
        \@minipagefalse
        \global \@newlistfalse
        \if@inlabel
          \global \@inlabelfalse
          { \setbox \z@ \lastbox \ifvoid \z@ \kern -\itemindent \fi }
          \box \@labels
          \penalty \z@
        \fi
        \if@nobreak
          \@nobreakfalse
          \clubpenalty \@M
        \else
          \clubpenalty \@clubpenalty
          \everypar { }
        \fi
      }
    \if@noitemarg
      \@noitemargfalse
      \if@nmbrlist \refstepcounter \@listctr \fi
    \fi
    \sbox \@tempboxa { \makelabel {#1} }
    \global \setbox \@labels \hbox
      {
        \unhbox \@labels
        \hskip \itemindent
        \hskip -\labelwidth
        \hskip -\labelsep
        \ifdim \wd \@tempboxa > \labelwidth
          \box \@tempboxa
        \else
          \hbox to \labelwidth { \unhbox \@tempboxa }
        \fi
        \hskip \labelsep
      }
    \ignorespaces
  }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Propriétés d'espacement
%%
%% Ces clés ne sont JAMAIS appliquées au moment où on les lit : elles se
%% déposent dans des macros nommées d'après le compteur de la liste, et ne
%% s'exécutent qu'une fois \@tempboxa chargée d'un échantillon d'étiquette.
%% La première qui s'exécute verrouille sa catégorie — les suivantes de même
%% nature sont ignorées, ce qui donne la priorité au réglage LOCAL sur le
%% réglage global.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\dim_const:Nn \c_az_liste_maxwidth_dim { 30pt }

%% marge  : la liste se cale sur la largeur d'étiquette, sans dépasser une
%%          limite au-delà de laquelle le retrait deviendrait absurde ;
%% marge+ : idem, sans la limite ;
%% marge* : retrait fixe, étiquette débordant dans la marge.
\cs_new_protected:Npn \az_liste_marge:nn #1#2
  {
    \cs_if_exist:cF { az@marge@ \az@listctr }
      {
        \dim_set:Nn \labelsep { .33em }
        \dim_set:cn { leftmargin \az@listlevel }
          { \az@labelwidth + \labelsep + #2 }
        \int_compare:nT {#1 = 1}
          {
            \dim_compare:nT
              { \dim_use:c { leftmargin \az@listlevel } > \c_az_liste_maxwidth_dim }
              {
                \dim_set:cn { leftmargin \az@listlevel }
                  { .5 \az@labelwidth + #2 }
              }
          }
        \cs_gset_protected:cpn { az@marge@ \az@listctr }
          {
            \dim_set:Nn \labelwidth
              { \dim_use:c { leftmargin \az@listlevel } - \labelsep }
            \dim_zero:N \itemindent
            \dim_zero:N \listparindent
          }
      }
  }

\cs_new_protected:Npn \az_liste_margealt:n #1
  {
    \cs_if_exist:cF { az@marge@ \az@listctr }
      {
        \dim_set:Nn \labelsep { .5em }
        \dim_set:cn { leftmargin \az@listlevel } {#1}
        \cs_gset_protected:cpn { az@marge@ \az@listctr }
          {
            \dim_zero:N \labelwidth
            \dim_set_eq:NN \itemindent \labelsep
            \dim_zero:N \listparindent
          }
      }
  }

\cs_new_protected:Npn \az_liste_topsep:n #1
  {
    \cs_if_exist:cF { az@avant@ \az@listctr }
      {
        \cs_gset_protected:cpn { az@avant@ \az@listctr }
          {
            \skip_set:Nn \l__az_liste_skip {#1}
            \dim_compare:nTF { \l__az_liste_skip = 0pt }
              { \skip_zero:N \topsep \skip_zero:N \itemsep }
              { \skip_set_eq:NN \topsep \l__az_liste_skip }
          }
      }
  }

\cs_new_protected:Npn \az_liste_sep:n #1
  {
    \cs_if_exist:cF { az@saut@ \az@listctr }
      {
        \cs_gset_protected:cpn { az@saut@ \az@listctr }
          {
            \skip_set:Nn \l__az_liste_skip {#1}
            \skip_add:Nn \itemsep { .5 \l__az_liste_skip }
            \skip_add:Nn \parsep  { .5 \l__az_liste_skip }
          }
      }
  }

\cs_new_eq:NN \az@left@listfil \hfil
\cs_new_eq:NN \az@right@listfil \relax

\cs_new_protected:Npn \az_liste_align:n #1
  {
    \cs_if_exist:cF { az@align@ \az@listctr }
      {
        \cs_gset_protected:cpn { az@align@ \az@listctr }
          {
            \str_case:nn {#1}
              {
                { r } { \cs_set_eq:NN \az@right@listfil \relax
                        \cs_set_eq:NN \az@left@listfil  \hfil }
                { l } { \cs_set_eq:NN \az@right@listfil \hfil
                        \cs_set_eq:NN \az@left@listfil  \relax }
                { c } { \cs_set_eq:NN \az@right@listfil \hfil
                        \cs_set_eq:NN \az@left@listfil  \hfil }
              }
          }
      }
  }

\keys_define:nn { az / lists / @props }
  {
    marge     .code:n    = { \az_liste_marge:nn {1} {#1} } ,
    marge     .default:n = { 0pt } ,
    marge+    .code:n    = { \az_liste_marge:nn {0} {#1} } ,
    marge+    .default:n = { 0pt } ,
    marge*    .code:n    = { \az_liste_margealt:n {#1} } ,
    marge*    .default:n = { 0pt } ,
    avant     .code:n    = { \az_liste_topsep:n {#1} } ,
    avant     .default:n = { \az@topsep@origin } ,
    saut      .code:n    = { \az_liste_sep:n {#1} } ,
    saut      .default:n = { \az@itemsep@origin } ,
    align     .code:n    = { \az_liste_align:n {#1} } ,
    align     .default:n = { r } ,
  }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Accumulation par niveau
%%
%% \azsetenum{2}{marge*=1pc} n'agit pas : il ajoute la propriété EN TÊTE de la
%% pile du niveau 2. La tête l'emporte au moment de la consommation, si bien
%% qu'un réglage tardif prime sur un réglage ancien sans avoir à l'effacer.
%% L'étoile vide la pile d'abord.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\cs_new_protected:Npn \az_liste_prop_add:nn #1#2
  {
    \cs_if_exist:cF { az@prop@ #1 } { \tl_new:c { az@prop@ #1 } }
    \tl_put_left:cn { az@prop@ #1 } { #2 , }
  }

\cs_new_protected:Npn \az_liste_prop_clear:n #1
  {
    \cs_if_exist:cTF { az@prop@ #1 }
      { \tl_clear:c { az@prop@ #1 } }
      { \tl_new:c { az@prop@ #1 } }
  }

\NewDocumentCommand \azsetenum { s m m }
  {
    \IfBooleanT {#1} { \az_liste_niveaux:nn {#2} { \az_liste_prop_clear:n } }
    \az_liste_niveaux:nn {#2} { \az_liste_prop_addto:nn {#3} }
  }

\NewDocumentCommand \azsetitem { s m m }
  {
    \IfBooleanT {#1} { \az_liste_niveaux:nn {#2} { \az_liste_prop_clear:n } [item] }
    \az_liste_niveaux:nn {#2} { \az_liste_prop_addto:nn {#3} } [item]
  }

%% Niveau 0 = « tous les niveaux » : c'est le réglage courant quand on veut
%% donner le même retrait à toute la profondeur d'un bloc.
\NewDocumentCommand \az_liste_niveaux:nn { m m O{enum} }
  {
    \int_compare:nTF {#1 > 0}
      { #2 { #3 \int_to_roman:n {#1} } }
      {
        \int_step_inline:nn {3}
          { #2 { #3 \int_to_roman:n {##1} } }
      }
  }

\cs_new_protected:Npn \az_liste_prop_addto:nn #1#2
  { \az_liste_prop_add:nn {#2} {#1} }

%% Réglages d'usine.
\tl_new:c {az@prop@enumi}   \tl_set:cn {az@prop@enumi}   { marge }
\tl_new:c {az@prop@enumii}  \tl_set:cn {az@prop@enumii}  { marge* }
\tl_new:c {az@prop@enumiii} \tl_set:cn {az@prop@enumiii} { marge }
\tl_new:c {az@prop@itemi}   \tl_set:cn {az@prop@itemi}   { marge=1pc }
\tl_new:c {az@prop@itemii}  \tl_set:cn {az@prop@itemii}  { marge=1pc }
\tl_new:c {az@prop@itemiii} \tl_set:cn {az@prop@itemiii} { marge=1pc }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Construction d'une liste
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\cs_new_protected:Npn \az@outerdeco@list #1 {#1}
\cs_new_protected:Npn \az@outeremptydeco@list #1 {#1}

\cs_new_protected:Npn \az_liste_outerdeco_init:
  {
    \cs_set:Npn \az@outerdeco@list ##1 {##1}
    \cs_set:Npn \az@outeremptydeco@list ##1 {##1}
  }

%% La largeur d'étiquette est MESURÉE, pas devinée : on compose l'étiquette du
%% treizième élément — assez large pour couvrir les cas courants sans être un
%% cas extrême — et on en tire le retrait.
\cs_new_protected:Npn \az_liste_setprop:
  {
    \cs_if_exist:cT { c@ \az@listctr }
      { \int_set:cn { c@ \az@listctr } {13} }
    \hbox_set:Nn \l__az_liste_box
      { \color@begingroup \az@outeremptydeco@list { } \color@endgroup }
    \dim_set:Nn \l__az_liste_dim { \box_wd:N \l__az_liste_box }
    \hbox_set:Nn \l__az_liste_box
      {
        \color@begingroup
          \use:c { az@deco@ \az@listctr } { \use:c { az@label@ \az@listctr } }
        \color@endgroup
      }
    \dim_set:Nn \az@labelwidth
      { \box_wd:N \l__az_liste_box + \l__az_liste_dim }
    \dim_compare:nT { \az@maxlabelwidth < \box_wd:N \l__az_liste_box }
      { \dim_gset:Nn \az@maxlabelwidth { \box_wd:N \l__az_liste_box } }
    \use:x
      {
        \exp_not:N \keys_set:nn { az / lists / @props }
          { \exp_not:v { az@prop@ \az@listctr } }
      }
  }

\cs_new_protected:Npn \az_liste_builder:
  {
    \az_liste_setprop:
    \exp_args:Nc \list { az@label@ \az@listctr }
      {
        \usecounter { \az@listctr }
        \use:c { az@avant@ \az@listctr }
        \use:c { az@marge@ \az@listctr }
        \use:c { az@saut@  \az@listctr }
        \use:c { az@align@ \az@listctr }
        \cs_set_eq:NN \makelabel \az_liste_makelabel:n
      }
  }

%% Variante non numérotée (xitem) : pas de compteur, et les décorations
%% externes sont neutralisées pour que la mesure porte sur la puce seule.
\cs_new_protected:Npn \az_liste_builder_star:
  {
    \cs_set:Npn \az@outeremptydeco@list ##1 {##1}
    \cs_set:Npn \az@outerdeco@list ##1 {##1}
    \az_liste_setprop:
    \exp_args:Nc \list { az@label@ \az@listctr }
      {
        \use:c { az@avant@ \az@listctr }
        \use:c { az@marge@ \az@listctr }
        \use:c { az@saut@  \az@listctr }
        \use:c { az@align@ \az@listctr }
        \cs_set_eq:NN \makelabel \az_liste_makelabel:n
      }
  }

\cs_new_protected:Npn \az_liste_makelabel:n #1
  {
    \tl_if_blank:nF {#1}
      {
        \null \az@left@listfil
          \az@outerdeco@list { \use:c { az@deco@ \az@listctr } {#1} }
        \az@right@listfil \null
      }
  }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Clés d'une liste en cours
%%
%% Forme courte, parce qu'elles s'écrivent EN LIGNE dans le document :
%%   n  numérotation        d  décoration       m  marge
%%   s  saut                a  alignement       bs saut avant
%%   cc compteur dédié      p  préfixe d'étiquette
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%% Les commandes xparse ne se prêtent pas à \exp_args:NV : leur premier
%% argument est une étoile facultative, et une valeur développée nue s'y
%% décomposerait token par token. On passe donc par une fonction :nn, dont la
%% variante V met bien la valeur entre accolades.
\cs_new_protected:Npn \az_liste_setlabel:nn #1#2 { \azsetlabel {#1} {#2} }
\cs_new_protected:Npn \az_liste_setdeco:nn #1#2 { \azsetdeco {#1} {#2} }
\cs_new_protected:Npn \az_liste_setdeco_star:nn #1#2 { \azsetdeco* {#1} {#2} }
\cs_generate_variant:Nn \az_liste_setlabel:nn { V }
\cs_generate_variant:Nn \az_liste_setdeco:nn { V }
\cs_generate_variant:Nn \az_liste_setdeco_star:nn { V }
\cs_generate_variant:Nn \az_liste_prop_add:nn { V }

\cs_new_protected:Npn \az_liste_horslist:n #1
  {
    \tl_if_empty:NT \az@xlistenv
      { \msg_warning:nnn { azkit } { liste-hors-contexte } {#1} }
  }

%% Mémorise les options pour un éventuel `restore` au niveau suivant.
\cs_new_protected:Npn \az_liste_save:n #1
  {
    \bool_if:NF \l__az_restore_bool
      { \clist_gput_right:Nn \g__az_liste_opts_clist {#1} }
  }

\cs_new_protected:Npn \az_liste_localprop:nn #1#2
  {
    \az_liste_horslist:n {#1}
    \az_liste_prop_add:Vn \az@listctr {#2}
  }

\keys_define:nn { az / lists }
  {
    n  .code:n = { \az_liste_horslist:n {n}
                   \az_liste_setlabel:Vn \az@listctr {#1}
                   \az_liste_save:n { n={#1} } } ,
    n* .code:n = { \az_liste_horslist:n {n*}
                   \cs_set_eq:cN { az@deco@ \az@listctr } \use:n
                   \az_liste_setlabel:Vn \az@listctr {#1}
                   \az_liste_save:n { n*={#1} } } ,
    d  .code:n = { \az_liste_horslist:n {d}
                   \az_liste_setdeco:Vn \az@listctr {#1}
                   \az_liste_save:n { d={#1} } } ,
    d* .code:n = { \az_liste_horslist:n {d*}
                   \az_liste_setdeco_star:Vn \az@listctr {#1}
                   \az_liste_save:n { d*={#1} } } ,
    m  .code:n = { \az_liste_localprop:nn {m}  { marge={#1} }  \az_liste_save:n { m={#1} } } ,
    m+ .code:n = { \az_liste_localprop:nn {m+} { marge+={#1} } \az_liste_save:n { m+={#1} } } ,
    m* .code:n = { \az_liste_localprop:nn {m*} { marge*={#1} } \az_liste_save:n { m*={#1} } } ,
    bs .code:n = { \az_liste_localprop:nn {bs} { avant={#1} }  \az_liste_save:n { bs={#1} } } ,
    bs* .code:n = { \az_liste_localprop:nn {bs*} { avant=0pt }  \az_liste_save:n { bs* } } ,
    s  .code:n = { \az_liste_localprop:nn {s}  { saut={#1} }   \az_liste_save:n { s={#1} } } ,
    a  .code:n = { \az_liste_localprop:nn {a}  { align={#1} }  \az_liste_save:n { a={#1} } } ,
    m  .default:n = { 0pt } ,
    m+ .default:n = { 0pt } ,
    m* .default:n = { 0pt } ,
    s  .default:n = { 0pt } ,
    bs .default:n = { \az@topsep@origin } ,
    a  .default:n = { r } ,
    %% Un compteur DÉDIÉ : la liste ne partage plus enumi et peut donc être
    %% reprise ailleurs sans que la numérotation générale n'en souffre.
    custom~counter .code:n =
      {
        \az_liste_horslist:n { custom~counter }
        \cs_if_exist:cF { c@ #1 } { \azdefcounter {#1} { } }
        \tl_set:Nn \az@listctr {#1}
      } ,
    cc .meta:n = { custom~counter = #1 } ,
    label~prefix .code:n = { \tl_set:Nn \az@enumlabelprefix {#1} } ,
    p  .meta:n = { label~prefix = #1 } ,
    item~label .code:n = { \az_liste_itemlabel:w #1 \q_stop } ,
    c  .code:n = { } ,
    %% Les clés de préchargement sont lues AVANT la construction ; ici elles ne
    %% font rien, pour qu'un même jeu d'options traverse les deux passes.
    resume .code:n = { } , restore .code:n = { } , save .code:n = { } ,
    r .code:n = { } , r* .code:n = { } ,
  }

\cs_new_protected:Npn \az_liste_itemlabel:w #1#2 \q_stop
  { \tl_set:cn { az@label@ item \int_to_roman:n {#1} } {#2} }

\keys_define:nn { az / lists / preload }
  {
    save    .bool_set:N = \l__az_save_bool ,
    restore .bool_set:N = \l__az_restore_bool ,
    resume  .bool_set:N = \l__az_resume_bool ,
    r  .meta:n = { resume, restore } ,
    r* .meta:n = { resume = false, restore } ,
    unknown .code:n = { } ,
  }

\NewDocumentCommand \azsetuplists { m } { \keys_set:nn { az / lists } {#1} }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Familles par niveau
%%
%% \azsetuplists{enumii={n=|a|, d=\bfseries #1)}} règle le DEUXIÈME niveau
%% partout dans le document, sans qu'une liste soit ouverte.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\cs_new_protected:Npn \az_liste_famille:nnn #1#2#3
  % #1 = enum|item, #2 = niveau romain, #3 = niveau arabe
  {
    \keys_define:nn { az / lists / #1 #2 }
      {
        n  .code:n = { \azsetlabel { #1 #2 } {##1} } ,
        n* .code:n = { \cs_set_eq:cN { az@deco@ #1 #2 } \use:n
                       \azsetlabel { #1 #2 } {##1} } ,
        d  .code:n = { \azsetdeco  { #1 #2 } {##1} } ,
        d* .code:n = { \azsetdeco* { #1 #2 } {##1} } ,
        m  .code:n = { \az_liste_prop_add:nn { #1 #2 } { marge={##1} } } ,
        m+ .code:n = { \az_liste_prop_add:nn { #1 #2 } { marge+={##1} } } ,
        m* .code:n = { \az_liste_prop_add:nn { #1 #2 } { marge*={##1} } } ,
        s  .code:n = { \az_liste_prop_add:nn { #1 #2 } { saut={##1} } } ,
        b  .code:n = { \az_liste_prop_add:nn { #1 #2 } { avant={##1} } } ,
        b* .code:n = { \az_liste_prop_add:nn { #1 #2 } { avant=0pt } } ,
        a  .code:n = { \az_liste_prop_add:nn { #1 #2 } { align={##1} } } ,
        a  .default:n = { r } ,
        m  .default:n = { 0pt } , m+ .default:n = { 0pt } ,
        m* .default:n = { 0pt } , s .default:n = { 0pt } ,
      }
    \keys_define:nn { az / lists }
      { #1 #2 .code:n = { \keys_set:nn { az / lists / #1 #2 } {##1} } }
  }

\clist_map_inline:nn { i, ii, iii, iv }
  {
    \az_liste_famille:nnn { enum } {#1} { }
    \az_liste_famille:nnn { item } {#1} { }
  }

