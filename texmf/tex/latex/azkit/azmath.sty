\def\azframe@err#1{\azmath@err
			{Aucune décoration #1 trouvée. 
			\MessageBreak Appuyez sur entrée pour l'ignorer}
			{les valeurs possibles sont formula (par défaut), \MessageBreak 
				result ou simplement r.}
		}

\long\def\eqn@prepareboxes#1#2#3{%
\@bsphack
	\setbox\z@\hbox{\eqnframecmd{}}
	\fadjwidth\wd\z@
	\setbox\azm@boxa\hbox{%
		\color@begingroup#2\color@endgroup%
	}
	\iftextmode
		\eqn@preparemidbox{#1}{#3}
		\setbox\azm@boxb\hbox{\az@indisplaytrue%
			\eqnframecmd{$\m@th
				\vcenter{
					\hsize\midwidth\@parboxrestore\box\midbox
			}$}
		}
	\else
		\setbox\azm@boxb\hbox{\az@indisplaytrue%
			\eqnframecmd{#3}%
	}
	\fi
	\setlength\az@dima{(\linewidth-\wd\azm@boxb)/2}
	\unless\ifdim\az@dima<\z@
		\setlength\az@dimb{\az@dima*(\l@qnshift-\r@qnshift)/10}
		\setlength\az@dima{\az@dima+\az@dimb}
		\setlength\az@dimc{\az@dima-\az@dimb}
	\fi
\@esphack%
}
\ifundef\az@removestar{%
	\def\az@removestar#1*{#1}%
	\def\az@removeplus#1+{#1}%
	\def\az@erasestar*#1+{#1}%
	\def\if@staratend#1{%
		\def\in@@{\in@{*!}}%
		\@xp\in@@\@xp{#1!}%
		\ifin@%
			\edef\x@arg{\az@removestar#1}\expandafter\@firstoftwo%
		\else%
			\def\x@arg{#1}\expandafter\@secondoftwo%
		\fi%
	}
	\def\if@plusatend#1{%
		\def\in@@{\in@{+!}}%
		\@xp\in@@\@xp{#1!}%
		\ifin@%
			\edef\x@arg{\az@removeplus#1}\expandafter\@firstoftwo%
		\else%
			\def\x@arg{#1}\expandafter\@secondoftwo%
		\fi%
	}%
}{}
\long\def\eqn@preparemidbox#1#2{%
\@bsphack
	\if@staratend{#1}{\def\@renderer{varwidth}}{\def\@renderer{minipage}}
	\edef\num@pt{\x@arg}
	\ifnum\numexpr\num@pt<50\relax
		\ifnum\numexpr\num@pt=0\relax
			\midwidth\hsize
		\else
			\midwidth.5\hsize
		\fi
	\else
		\setlength\midwidth{\hsize*\ratio{\num@pt\p@}{100\p@}}
	\fi
	\midwidth=\dimexpr\midwidth-\fadjwidth\relax
	\eqn@setmidbox{#2}
	\setlength\midwidth{\wd\midbox+\fadjwidth}
\@esphack%
}
\long\def\eqn@setmidbox#1{%
	\setbox\midbox\hbox{%
		\hbadness\@M\az@count\z@%
		\begin{\@renderer}\midwidth%
			\az@minipagetrue%
			\everymath{\displaystyle}%
			\abovedisplayskip\medcenterskip%
			\belowdisplayskip\medcenterskip%	
		 		#1%
		\end{\@renderer}%
	}%
}
