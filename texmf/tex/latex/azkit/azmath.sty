\def\get@arg#1^{#1}
\def\get@var#1{\get@var@#1^\az@nil}
\let\der@var\@empty
\let\order@csv\@empty
\def\get@var@#1^#2\az@nil{%
	\ifblank{#2}
		{%
			\def\az@tmpo{1}
			\appto\order@csv{, 1}
			\eappto\der@var{\@nx\diff@sym #1}
		}{%
			\edef\az@tmpo{\get@arg #2}
			\eappto\order@csv{, \az@tmpo}
			\eappto\der@var{\@nx\diff@sym #1\@nx\xsubsup[h=0,t=0]^{\az@tmpo}}
		}
}
\XDeclareDelimiters\xder{s e{\or\vl} mm }
	{%	
		\def\diff@sym{\dsymb}
		\get@var{#5}
		\ifdefstring{\az@tmpo}{1}
			{\def\der@func{\diff@sym #4}}
			{\def\der@func{\diff@sym\xsubsup[h=-2]^{\az@tmpo}#4}}
		\def\der@frac{%
			\IfBooleanTF{#1}
				{\xfrac*{\der@func}{\der@var}}
				{\xfrac[d=\fake@cmd]{\der@func}{\der@var}}
		}
		\IfValueT{#3}
			{\def\delimafterhook{\vphantom{\der@frac}\,\vrule}}
		\der@frac
	}
	{##1}
	{\IfValueT{#3}{\xsubsup[h=0,cs]_{#3}}}
	
\XDeclareDelimiters\xderp{s e{\or\vl} mm }
	{%	
		\let\der@var\@empty
		\let\order@csv\@empty
		\def\diff@sym{\partial}
		\forcsvlist\get@var{#5}
		\@xp\calc@totorder\@xp\az@tmpo\@xp{\order@csv}
		\IfValueT{#2}{\def\az@tmpo{#2}}
		\ifdefstring{\az@tmpo}{1}
			{\def\der@func{\diff@sym #4}}
			{\def\der@func{\diff@sym\xsubsup[h=-2,t=0]^{\az@tmpo}#4}}
		\def\der@frac{%
			\IfBooleanTF{#1}
				{\xfrac*{\der@func}{\der@var}}
				{\xfrac[d=\fake@cmd]{\der@func}{\der@var}}
		}
		\IfValueT{#3}
			{\def\delimafterhook{\vphantom{\der@frac}\,\vrule}}
		\der@frac
	}
	{##1}
	{\IfValueT{#3}{\xsubsup[h=0,cs]_{#3}}}

\XDeclareDelimiters\xdiff{E{^_}{{}{}} m}
	{
		\opn{\dsymb}
		\xsubsup[h=0,b=-2]^{#1}_{#2}
