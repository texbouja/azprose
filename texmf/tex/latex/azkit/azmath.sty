\long\def\xalign@ltextfunc#1{%
	\az@indisplayfalse
	\ifmeasuring@ 
		\hbox{}
		\text@mesuring{ltext}{#1}
	\else
		\advance\row@\@ne
		\if0\get@entry\row@\left@shifts\relax
			\rlap{#1}
		\else
			\largetext{#1}
		\fi
	\fi
}
\def\xalign@rtextfunc#1{%
	\az@indisplayfalse
	\ifmeasuring@
		\hbox{}
		\tag@measuring{\az@tmpl}
		\text@mesuring{rtext}{#1}
		\tag@in@align*{}
	\else
		\@xp\set@tag\@xp{\az@tmpl}
		\global\shifttag@true
		\raisetag{-\numvskip}
		\tag@in@align*{#1\box\azm@boxa}
	\fi
}
