%%% le système \xsave
\listadd\azsaved@list{@@@}
\NewDocumentCommand\x@save{sm+m}{#3}
\NewDocumentCommand\xsave{sm+m}{%
	\begingroup
	\def\xsave{\x@save}
	\ifmeasuring@\else
		\ifcsdef{saved@#2}
			{\azsave@err{#2}{déjà utilisé}}
			{%
				\csgdef{saved@#2}{#3}%
				\listgadd\azsaved@list{#2}%
			}
	\fi
	\IfBooleanF{#1}{#3}%
	\endgroup
}
\NewDocumentCommand\xsaved{m}{%
	\ifmeasuring@
		\csuse{saved@#1}
	\else
		\ifcsundef{saved@#1}
			{\azsave@err{#1}{non trouvé}}
			{\csuse{saved@#1}}
	\fi
}
\NewDocumentCommand\DeleteSaved{o}{%
	\begingroup%
	\def\do##1{%
		\csgundef{saved@##1}%
		\listgremove\azsaved@list{##1}%
	}%
	\IfValueTF{#1}
		{%
			\forcsvlist{\listadd\aztmpsaved@list}{#1}
			\dolistloop\aztmpsaved@list
		}
		{\dolistloop\azsaved@list}
	\makeatletter
		\listgadd\azsaved@list{@@@}
	\makeatother
	\endgroup
}
\def\azsave@err#1#2{\azmath@err{enregistrement #1\space #2}{}}


