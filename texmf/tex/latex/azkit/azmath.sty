%%%%% Commandes utilitaires
%% \azsetdeco vient de azbase, et de nulle part ailleurs. cpgemath en portait
%% une definition de repli qui rangeait ses decorations sous \az@deco@<nom>, la ou
%% le socle les range sous \az@deco@<nom> : les deux vues divergeaient des que
%% le module etait charge seul, et \azusedeco ne trouvait plus rien.
%% Le repli est donc supprime au profit de la dependance explicite.
\let\fake@cmd\@iden
\newcommand\@ifisnumber[1]{%
        \begingroup
        \edef\temp@{#1}%
        \@xp\ifstrempty\@xp{\temp@}
                {\endgroup\@secondoftwo}
                {\@xp\if@number@i\temp@\@nnil}%
}
\def\if@number@i#1#2\@nnil{%
        \if-#1%
                \gdef\temp@s{-}
                \ifstrempty{#2}
                        {\def\temp@{X}}
                        {\def\temp@{#2}}%
        \else
                \gdef\temp@s{+}
                \def\temp@{#1#2}%
        \fi
        \xdef\temp@n{\temp@}
        \afterassignment\if@numhelper
        \count@0\temp@\relax\@nnil
        \endgroup
}

\def\num@relax{\relax}%
\def\if@numhelper#1\@nnil{%
        \def\temp@{#1}%
        \ifx\temp@\num@relax
                \aftergroup\@firstoftwo
        \else
                \aftergroup\@secondoftwo
        \fi
}

\def\is@num#1#2#3{%
  \if!\ifnum9<1#1!\else_\fi
    #3\else#2\fi
  }
  
