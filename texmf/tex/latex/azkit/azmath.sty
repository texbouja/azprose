\cs_new:Npn \__azmath_calc_tot_order:NN #1 #2
  {
    \tl_clear:N \l__azmath_nos_tl
    \exp_args:Nx\__azmath_digest_expr:n { \seq_use:Nn #1 { + } }
    \prop_if_empty:NTF \l__azmath_vars_prop
      { \tl_set:NV #2 \l__azmath_nos_tl }
      { \__azmath_evaluate:NN \l__azmath_vars_prop #2 }
  }
%%%%%
\cs_new:Npn \__azmath_digest_expr:n #1
  {
    \tl_set:Nn \l__azmath_curr_num_tl { + }
    \tl_set:Nn \l__azmath_paren_tl { +1 }
    \tl_set:Nn \l__azmath_nos_tl { 0 }
    \int_zero:N \l__azmath_curr_state_int
    \int_zero:N \l__azmath_curr_tok_int
    \tl_map_inline:nn { #1+ }
      { 
        \__azmath_get_curr_ndx:nN { ##1 } \l__azmath_curr_tok_int
        \__azmath_transitions:nNN { ##1 } 
            \l__azmath_curr_state_int \l__azmath_curr_tok_int 
      }
    \int_set:Nn \l__azmath_nos_int { \l__azmath_nos_tl }
    \tl_set:Nx \l__azmath_nos_tl { \int_use:N \l__azmath_nos_int }
    \int_compare:nNnT { \l__azmath_nos_int } = { 0 }
      { \tl_clear:N \l__azmath_nos_tl }
  }
% #1 curr tok (tl); #2 <== curr tok ndx (int)
%%%%%%%
\cs_new_protected:Npn \__azmath_get_curr_ndx:nN #1#2
  { 
    \tl_if_in:NnTF \c__azmath_digits_tl { #1 }
      { \int_set:Nn #2 { 1 } } % digit
      { 
        \str_case:nnF { #1 }
          {
            { + } { \int_set:Nn #2 { 0 } }
            { - } { \int_set:Nn #2 { 0 } }
            { ( } { \int_set:Nn #2 { 3 } }
            { ) } { \int_set:Nn #2 { 4 } }
          }
          { \int_set:Nn #2 { 2 } }  % var
      }
  }
% #1(tl) curr tok; #2(int) curr state; #3(int) curr tok ndx
%%%%%%%%
\cs_new:Npn \__azmath_transitions:nNN #1#2#3
  { 
    \int_case:nn { #2 }
      { 
        { 0 } % sgn + -
          { \__azmath_sgn_transitions:nNN { #1 }#2#3 }
        { 1 } % num 
          { \__azmath_num_transitions:nNN { #1 }#2#3 }
        { 2 } % alg
          { \__azmath_alg_transitions:nNN { #1 }#2#3 }
        { 4 } % )
          { \__azmath_rpar_transitions:nNN { #1 }#2#3 }
      }
  }
% transitions from the signed state
% #1(tl) curr tok; #2(int) 0, curr state; #3 curr tok ndx
%%%%%%
\cs_new_protected:Npn \__azmath_sgn_transitions:nNN #1#2#3
  {
    \int_case:nnT { #3 }
      {
        { 0 } % tok = s
          {
            \tl_if_eq:nVTF { #1 } \l__azmath_curr_num_tl
              { \tl_set:Nn \l__azmath_curr_num_tl { + } }
              { \tl_set:Nn \l__azmath_curr_num_tl { - } }
          }
        { 1 } % tok = d
          { \tl_put_right:Nn \l__azmath_curr_num_tl { #1 } }
        { 2 } % tok = v
          {
            \tl_put_right:Nn \l__azmath_curr_num_tl { 1 }
            \tl_set:Nn \l__azmath_curr_var_tl { #1 }
          }
        { 3 } % tok = (
          {
            \seq_push:NV \l__azmath_paren_seq \l__azmath_paren_tl
            \tl_put_left:NV \l__azmath_paren_tl \l__azmath_curr_num_tl
            \tl_set:Nn \l__azmath_curr_num_tl { + }
            \int_set:Nn #3 { 0 }
          }
      }
      { \int_set_eq:NN #2 #3 }
  }
% transitions from the numeric state
% #1 = curr. tok.; #2 = 0, curr. state; #3 curr. tok. index
%%%%%%%%
\cs_new_protected:Npn \__azmath_num_transitions:nNN #1#2#3
  {
    \int_case:nnT { #3 }
      {
        { 0 } % tok = s
          {
            \tl_put_right:NV\l__azmath_nos_tl 
              { \l__azmath_paren_tl * \l__azmath_curr_num_tl }
            \tl_set:Nn \l__azmath_curr_num_tl { #1 } 
          }
        { 1 } % tok = d
          { \tl_put_right:Nn \l__azmath_curr_num_tl { #1 } }
        { 2 } % tok = v
          {
            \tl_if_in:nnTF { ^ \times * / \div } { #1 }
              {
                \msg_error:nnxxx { azmath } { order-specification } 
                { \seq_use:Nn \l__azmath_orders_seq { , } } 
                { #1 } { number }
              }
              { \tl_set:Nn \l__azmath_curr_var_tl { #1 } }
          }
        { 3 } % tok = (
          { 
            \seq_push:NV \l__azmath_paren_seq \l__azmath_paren_tl
            \tl_put_left:Nn \l__azmath_paren_tl { * }
            \tl_put_left:NV \l__azmath_paren_tl \l__azmath_curr_num_tl
             \tl_set:Nn \l__azmath_curr_num_tl { + }
            \int_set:Nn #3 { 0 } 
          }
        { 4 } % tok = )
          {
            \tl_put_right:NV \l__azmath_nos_tl 
                { \l__azmath_paren_tl * \l__azmath_curr_num_tl }
          }
      }
      { 
        \int_set_eq:NN #2 #3 }
  }
% transitions from the algebraic state
% #1 = curr. tok.; #2 = 2, curr. state; #3 curr. tok. index
%%%%%%%%%
\cs_new:Npn \__azmath_alg_transitions:nNN #1#2#3
  { 
    \int_case:nnT { #3 }
      {
        { 0 } % tok = s
          { 
            \int_compare:nNnTF { \l__azmath_parenvar_int } = { 0 }
              {
                \__azmath_store_var:NNN \l__azmath_curr_var_tl
                    \l__azmath_paren_tl \l__azmath_curr_num_tl
                \tl_clear:N \l__azmath_curr_var_tl
                \tl_set:Nn \l__azmath_curr_num_tl { #1 }
              }
              {
                \tl_put_right:Nn \l__azmath_curr_var_tl { #1 }
                \int_set:Nn #3 { 2 }
              }
          }
        { 1 } % tok = d
          { 
            \tl_put_right:Nn \l__azmath_curr_var_tl { #1 } 
            \int_set:Nn #3 { 2 }
          }
        { 2 } % tok = v
          { \tl_put_right:Nn \l__azmath_curr_var_tl { #1 } }
        { 3 } % tok = (
          {
            \tl_put_right:Nn \l__azmath_curr_var_tl { #1 }
            \int_set:Nn #3 { 2 }
            \int_incr:N \l__azmath_parenvar_int
          }
        { 4 } % tok = )
          {
            \int_compare:nNnTF { \l__azmath_parenvar_int } = { 0 }
              {
                \__azmath_store_var:NNN \l__azmath_curr_var_tl
                    \l__azmath_paren_tl \l__azmath_curr_num_tl
                \tl_clear:N \l__azmath_curr_var_tl
              }
              {
                \tl_put_right:Nn \l__azmath_curr_var_tl { #1 }
                \int_set:Nn #3 { 2 }
                \int_decr:N \l__azmath_parenvar_int
              }
          }
      }
      { \int_set_eq:NN #2 #3 }
  }
% transitions from the ) state
% #1 = curr. tok.; #2 = 4, curr. state; #3 curr. tok. index
%%%%%%%%%%%
\cs_new:Npn \__azmath_rpar_transitions:nNN #1#2#3
  {
    \int_compare:nNnTF { \int_mod:nn { #3 } { 4} } = { 0 }
      { 
        \tl_set:Nn \l__azmath_curr_num_tl { #1 }
        \seq_pop:NN \l__azmath_paren_seq \l__azmath_paren_tl
        \int_set_eq:NN #2 #3
      }
      {
        \msg_error:nnxxx { azmath } { order-specification } 
            { \seq_use:Nn \l__azmath_orders_seq { , } } { #1 } { ) }
      }
  }
% #1 is var. (tlvar); #2 is num. (tlvar); #3 num. coeff. (tlvar)
\cs_new:Npn \__azmath_store_var:NNN #1#2#3
  {
    \prop_get:NVNF \l__azmath_vars_prop #1 \l_tmpa_tl
      { \tl_clear:N \l_tmpa_tl }
    \tl_put_right:NV \l_tmpa_tl { #2 * #3 }
    \prop_put:NVV \l__azmath_vars_prop #1 \l_tmpa_tl
  }
% #1 (propv) key=var, val=coeff; #2 <= total order
%%%%%%
\cs_new_protected:Npn \__azmath_evaluate:NN #1#2
  {
    \prop_map_inline:Nn #1 { \seq_put_left:Nn \l_tmpa_seq { ##1 } }
    \seq_sort:Nn \l_tmpa_seq
      {
        \int_compare:nNnTF { \tl_count:n { ##1 } } < { \tl_count:n { ##2 } }
          { \sort_return_same: } { \sort_return_swapped: }
      }
    \seq_map_inline:Nn \l_tmpa_seq
      {
        \prop_pop:NnN #1 { ##1 } \l_tmpb_tl
        \seq_put_right:Nx \l_tmpb_seq { \int_eval:n \l_tmpb_tl }
       }
    \tl_clear:N \l_tmpa_tl
    \seq_mapthread_function:NNN \l_tmpa_seq \l_tmpb_seq 
        \__azmath_tot_order:nn
    \exp_args:NV \tl_if_head_eq_charcode:nNTF \l_tmpa_tl +
      { 
        \tl_set:Nx \l_tmpb_tl { \tl_tail:N \l_tmpa_tl }
        \int_compare:nNnT { \l__azmath_nos_int } > { 0 }
          { \tl_put_left:Nn \l__azmath_nos_tl { + } }
         \tl_concat:NNN #2 \l_tmpb_tl \l__azmath_nos_tl
      }
      { 
        \int_compare:nNnTF { \l__azmath_nos_int } > { 0 }
          { \tl_concat:NNN #2 \l__azmath_nos_tl \l_tmpa_tl }
          { \tl_concat:NNN #2 \l_tmpa_tl \l__azmath_nos_tl }
      }
    \tl_set_rescan:Nno #2 { } #2
  }
%%%%%%
\cs_new:Npn \__azmath_tot_order:nn #1#2
  { 
    \int_compare:nNnTF { #2 } > { 0 }
      { 
        \int_compare:nNnTF { #2 } = { 1 }
          { \tl_put_left:Nn \l_tmpa_tl { +#1 } }
          { \tl_put_left:Nn \l_tmpa_tl { +#2#1 } }
      }
      {
        \int_compare:nNnT { #2 } < { 0 }
          { 
            \int_compare:nNnTF { #2 } = { -1 }
              { \tl_put_right:Nn \l_tmpa_tl { -#1 } }
              { \tl_put_right:Nn \l_tmpa_tl { #2#1 } }
          }
      }
  }

\NewDocumentCommand\calc@totorder{ mm }
	{
		\seq_set_from_clist:Nn \l__azmath_orders_seq { #2 }
		\__azmath_calc_tot_order:NN  \l__azmath_orders_seq #1
	}

