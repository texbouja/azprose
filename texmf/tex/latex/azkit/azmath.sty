%% \xboxed normale

\NewDocumentCommand\MakeXboxedCommand{mm}{
	\newcommand#1[1]{%
		\let\bgroup{\romannumeral-`}%
		\csuse{xbxd\@xp\@gobble\string#1}##1&&\az@nil
	}
	\csdef{xbxd\@xp\@gobble\string#1}##1&##2&##3\az@nil{%
		\settowidth\az@dimc{#2{}}%
		\ifnum0=`{}\fi%
		\setbox\z@\hbox{#2{$\displaystyle##1{}\m@th$\kern-.5\az@dimc}}%
		\edef\az@tmpa{%
			\kern\wd\z@&\kern-\the\wd\z@%
		}%
		\ifblank{##1##2}{}
			{%
				\az@tmpa%
				#2{\m@th$\displaystyle ##1##2$}%
			}%
  }
}	
\MakeXboxedCommand\xboxed\az@deco@formula
\MakeXboxedCommand\az@xdeco@formula\az@deco@formula
\MakeXboxedCommand\az@xdeco@result\az@deco@result
\def\az@xdeco@r{\az@xdeco@result}

%%%% \Xboxed, version récursive de \xboxed
\NewDocumentCommand\Xboxed
{
	O{formula} >{\SplitList{&}} m
}{
	\ifcsundef{az@xdeco@#1}
		{\azframe@err{#1}}
		{\gdef\eqnframecmd{\csname az@xdeco@#1\endcsname}}
	\xboxed@rec@#2@@\frame@nil%
}
\def\xboxed@rec@#1#2#3\frame@nil{%
	\gdef\@tmpa{#3}%
	\ifstrequal{#1}{@}{}
	{
		\ifstrequal{#2}{@}
			{\eqnframecmd{#1}}
			{%
				\eqnframecmd{#1&#2}%
				\@xp\@ifnc@t\@tmpa\frame@nil%
			}%
	}%
}
\def\@ifnc@t#1#2\frame@nil{%
	\ifstrequal{#1}{@}{}{&\@xp\xboxed@rec@#1#2\frame@nil}%
}			

