\def\begin@center@{}
\long\def\eqn@item#1#2#3#4#5{%
	%\begingroup%
	\eqn@prepareboxes{#1}{#2}{#3}%
	\ifdim\wd\azm@boxa>\az@dima\relax%
		% \ifhmode%
		% 	\unskip\par\nobreak\vskip-\parskip\noindent%
		% \fi%
		%\unskip\unskip\unskip%
		\ignorespaces\unhbox\azm@boxa\hfill\par%
		\vskip-\lineskiplimit%
        \vskip\normallineskiplimit%
		\vskip\medcenterskip%
	\fi%
	\hacked@item%
	\hb@xt@\z@{\unhcopy\azm@boxa\hss}%
	\setbox\azm@boxb\hbox{\kern\az@dimb\box\azm@boxb}%
	\ifdim\wd\azm@boxb>\linewidth%
		\hskip-\@totalleftmargin%
		\setbox\azm@boxb\hb@xt@\linewidth{\unhbox\azm@boxb}%
	\fi%
	\m@az@stop%
	\hskip\z@\@plus .5fill%
	\box\azm@boxb%
	\hskip\z@\@plus .5fill%
	\m@az@stop%
	\protected@edef\az@tmpl{#5}%
	\ifeqn@number%
		\refstepcounter{equation}%
		\setbox\azm@boxc\hbox{%
			\tag@kern\az@deco@tag{\theequation}%
		}%
		\unless\ifx\@empty\az@tmpl%
			\Make@Link%
			\label{eq:\az@problem@id:\az@tmpl}%
		\fi%
	\else%
		\ifx\@empty\az@tmpl%
			\setbox\azm@boxc\hbox{}%
		\else%
			\setbox\azm@boxc\hbox{\tag@kern\az@deco@tag{\az@tmpl}}%
		\fi%
	\fi%
	\ifdim\wd\azm@boxc>\z@\relax%
		\ifdim\az@dimc>\wd\azm@boxc\relax%
			\hb@xt@\z@{\hss\box\azm@boxc}%
			\setbox\azm@boxc\hbox{\xtrimspaces{#4}}%
			\ifdim\wd\azm@boxc>\z@%
				\m@az@par\nobreak\vskip\numvskip\hfill%
			\fi%
		\else%
			\setbox\azm@boxc\hbox{%
				\xtrimspaces{#4}\unhbox\azm@boxc%
			}%
			\m@az@par\nobreak\vskip\numvskip\hfill%
		\fi%\x@hackitem
	\else%
		\setbox\azm@boxc\hbox{\xtrimspaces{#4}}%
		\ifdim\wd\azm@boxc>\az@dimc%
			\m@az@par\nobreak\vskip\numvskip\hfill%
		\fi%
	\fi%
	\ifdim\wd\azm@boxc>\z@%
		\hb@xt@\z@{\hss\box\azm@boxc}%
	\fi%
	\ifaz@minipage%
		\aftergroup\leavevmode\aftergroup\par%
	\fi%
	\endtrivlist%
}
