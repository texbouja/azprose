%% Pour maintenir une compatibilité visuelle lorsque des \cas figurent
%% dans un environnement {xalign} ou {xdevel} de azmath.sty
\NewDocumentCommand\math@unit{ s O{} }{%
	\ifdim\leftmargin=\z@
		\leftmargin=\leftmargini%
	\fi
	\IfBooleanTF{#1}
		{%
			\parshape=1 \leftmargin \dimexpr\linewidth-\leftmargin\relax%
			\ignorespaces
		}
		{%
			\parshape=2	\z@				\linewidth
						\leftmargin		\dimexpr\linewidth-\leftmargin\relax%
			%% `unite` et non `unit` : la decoration s'appelle ainsi partout
			%% ailleurs, et le commentaire ci-dessus dit l'intention — rendre
			%% un \cas comme il se rend hors alignement. Ce chemin appelait
			%% \deco@unit, jamais declaree : il ne produisait rien.
			%%
			%% Par \azusedeco et non par la macro nue : c'est azlist qui declare
			%% cette decoration, et azmath se charge aussi tout seul. L'accesseur
			%% du socle rend alors l'identite au lieu d'echouer.
			\noindent\azusedeco{unite}{#2}\enskip\ignorespaces
		} 
}
