%% 		field in the line. 
%%			Queue order
%% 			\fieldlengths@ for the extraction of a line
%% \tag@lengths : 
%%		\or list with the width of the tags on every line.
%% 			Queue order
%% 			\tag@width for the extraction
%% \tag@shifts : 
%%		\or list of 0 and 1, 1 indicating à tag shift of the 
%% 		corresponding line. 
%%			Stack order. 
%% 			\shift@tag for the extraction
%% \maxcolumn@widths : 
%%		\or list of the max width on every column. 
%%			Stack order
%% 			\maxcol@width for the extraction



%%%%% Macros pour le traitement des données générées par 
%%%%% la phase measuring d'amsmath
\let\tag@presence\@empty	% \or list of 0 and 1 indicating lines with tag
\let\lastfields@\@empty		% \or list of the indices of the last non empty columns
\let\firstfields@\@empty	% same thing for the first non empty fields
\let\ltext@widths\@empty	% \or list of the left text widths
\let\rtext@widths\@empty	% \or list of the text text widths	
\let\left@shifts\@empty		% \or list of 0 and 1 indicating shifts for the left 
							% text. there's no \right@shifts, amsmath's native 
							% \tag@shifts is used instead 

\def\save@entry#1#2{%
    \begingroup
        \let\or\relax
        \xdef#2{#2\or #1}%
    \endgroup
}
\def\save@csentry#1#2{%
    \begingroup
        \let\or\relax
        \csxdef{#2}{\csname#2\endcsname \or #1}%
    \endgroup
}
\def\get@entry#1#2{%
	\ifcase\@xp#1#2\fi
}
\def\text@mesuring#1#2{%
	\begingroup%
		\settowidth\az@dima{#2}
		\save@csentry{\the\az@dima}{#1@widths}
	\endgroup
}
\def\get@fieldwidth#1#2#3{
	\begingroup
	\az@loop\z@
	\edef\az@tmpb{\fieldlengths@#1}%
	\@for\az@tmpa:=\az@tmpb\do{%
            \advance\az@loop\@ne
            \ifnum\az@loop=#2\relax
            	\edef\az@tmpc{\az@tmpa}
			\fi
	}
	\xdef#3{\az@tmpc}
	\endgroup
}
\def\save@firstlastfields{
	\begingroup
	\def\do@row##1{	
		\column@\z@
		\docsvlist{##1}
		\ifundef\az@tmpfirst
			{
				\save@entry0\firstfields@
				\save@entry0\lastfields@
			}{
				\save@entry\az@tmpfirst\firstfields@
				\save@entry\az@tmplast\lastfields@
			}
		\undef\az@tmpfirst
	}
	\def\do##1{%
		\advance\column@\@ne
		\ifdim##1>\z@\relax
			\ifundef\az@tmpfirst{\edef\az@tmpfirst{\the\column@}}{}
			\edef\az@tmplast{\the\column@}
		\fi
	}
	\@xp\fororloop\@xp\do@row\@xp{\field@lengths}
	\endgroup
}
\def\find@maxtagwidth#1{%
	\begingroup%
		\settowidth\az@dima{\tag@kern\az@deco@tag{#1}}
		\ifdim\az@dima>\aztag@width
			\global\aztag@width\az@dima
		\fi
		\setbox\z@\hbox{\tag@kern\az@deco@tag{}}
		\ifdim\az@dima>\wd\z@
			\save@entry1\tag@presence
		\else
			\save@entry0\tag@presence
		\fi
	\endgroup
}
\def\tag@measuring#1{%
	\ifeqn@number
		\stepcounter{equation}%
		\find@maxtagwidth{\theequation}
	\else
		\find@maxtagwidth{#1}
	\fi
}
\def\set@tag#1{%
	\ifeqn@number
		\refstepcounter{equation}%
		\setbox\azm@boxa\hbox{%
			\tag@kern\az@deco@tag{\theequation}%
		}
		\ifblank{#1}{}{\label{#1}}
	\else
		\ifblank{#1}
			{\setbox\azm@boxa\hbox{}}
			{%
				\setbox\azm@boxa\hbox{%
					\tag@kern\az@deco@tag{#1}
				}
			}
	\fi
	\ifdim\wd\azm@boxa>\z@
		\global\setbox\azm@boxa\hb@xt@\aztag@width{%
			\hss\unhbox\azm@boxa
		}
	\fi
}
%%%% Main macro. Prepare the shift tables for left and right text 
%%%% after amsmath's measuring is done.
\def\after@measuring{\begingroup
	\numdef\rows@number{\row@}
	\save@firstlastfields
	\row@\z@
	\column@\z@	
	\let\left@shifts\@empty
	\let\tag@shifts\@empty
	\whileboolexpr{ test {\ifnumless\row@\rows@number} }
		{
			\advance\row@\@ne
			\edef\az@tmpf{\get@entry\row@\firstfields@}
			\get@fieldwidth\row@\az@tmpf\az@tmpd
			\az@dimb=\dimexpr-\mintagsep-\az@tmpd\relax
			\column@\z@
			\whileboolexpr{ test {\ifnumless\column@{\az@tmpf}} }
				{
					\advance\column@\@ne
					\advance\az@dimb\maxcol@width\column@\relax
					\unless\ifodd\column@
						\advance\az@dimb\alignsep@
					\fi
				}
			\az@dimc\get@entry\row@\ltext@widths\relax
			\ifdim\az@dimb<\az@dimc
				\save@entry1\left@shifts
			\else
				\save@entry0\left@shifts
			\fi
		}
	\row@\z@	\column@\z@
	\whileboolexpr{ test {\ifnumless\row@\rows@number} }
		{
			\advance\row@\@ne
			\column@\get@entry\row@\lastfields@\relax
			\get@fieldwidth\row@\column@\az@tmpd
			\az@dimb=-\az@tmpd
			\whileboolexpr{ test {\ifnumless\column@{\maxfields@+1}} }
				{
					\advance\az@dimb\maxcol@width\column@\relax
					\unless\ifodd\column@
						\advance\az@dimb\alignsep@
					\fi
					\advance\column@\@ne
				}
			\advance\az@dimb-\alignsep@\relax
			\advance\az@dimb-\mintagsep\relax
			\az@dimc\get@entry\row@\rtext@widths\relax
			\if1\get@entry\row@\tag@presence\relax
				\advance\az@dimc\aztag@width
			\fi
			\ifdim\az@dimc<\az@dimb
				\save@entry0\tag@shifts
			\else
				\save@entry1\tag@shifts
			\fi
		}
	\global\let\ltext@widths\@empty
	\global\let\rtext@widths\@empty
	\global\let\firstfields@\@empty
	\global\let\lastfields@\@empty
	\global\let\tag@presence\@empty
\endgroup}

\long\def\start@xalign#1#2{%
    \let\xatlevel@\tw@
    \maxfields@\m@ne\relax
    \ifingather@
        \iffalse{\fi\ifnum0=`}\fi
        \DN@{\vcenter\bgroup\savealignstate@\xalign@}%
    \else
        \ifmmode
          \if@display
             \DN@{\align@recover}%
          \else
            \nomath@env
            \DN@{\@namedef{end\az@currenvir}{}\@gobble}%
          \fi
        \else
            $$%
            \let\split\insplit@
            \DN@{\xalign@{#1}{#2}}%
        \fi
    \fi
    \collect@body\next@
}
\iffalse $$\fi% Hack benin pour interrompre la coloration syntaxique causée par $$ dans l'éditeur . 
\def\xalign@#1#2#3{%
	\inalign@true
	\az@indisplaytrue
	\chardef\dspbrk@context\z@
	\ifingather@\else\displ@y@\fi
	\let\math@cr@@@\math@cr@@@align
	\let\tag\tag@in@align
	\let\invalid@tag\xalign@tag@err
	\let\label\label@in@display
	\st@rredtrue% set st@r
	\def\xalign@BODY{#3}
	\preto\xalign@BODY{#1}
	\appto\xalign@BODY{#2}
%	\show\xalign@BODY
	\xalign@BODY
	\@xp\def\@xp\xalign@BODY\@xp{\az@tmpw}
%	\show\xalign@BODY
	\measure@{\xalign@BODY}%
	\after@measuring
	\global\row@\z@
	\tabskip\eqnshift@
	\halign\bgroup
		\span\align@preamble\crcr
		\xalign@BODY%
}
