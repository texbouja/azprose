\NewDocumentCommand\xmath@init{
		t\n % numbered or not 
		t\r % framed text mode for the mid part
		t\t % unframed text mode for the mid part
}{
	\let\eqnframecmd\eqn@fakecmd%
	\IfBooleanTF{#1}%
		{\eqn@numbertrue}%
		{\eqn@numberfalse}%
	\IfBooleanTF{#2}%
		{\is@resulttrue}%
		{\is@resultfalse}%
	\IfBooleanTF{#3}%
		{\textmodetrue}%
		{\textmodefalse}%
	\xmath@preprocess%
}
\NewDocumentCommand\xmath@preprocess{
	E{
		\lt % #1 : left text
		\rt % #2 : right text
		\ls % #3 : left shift
		\rs % #4 : right shift 
		\fr % #5 : framed or not 
		\al % #6 : aligned or not 
		\wd % #7 : minipage width, sets \textmodetrue
		\lb % #8 : \label, if numbered
		\vs % #9 : skip to add to \bigcenterskip
	}{{}{}{}{}{@}{@}{}{@}{}}
}{%
	\def\minipage@wd{100*}%
	\def\az@tmpl{#1}%
	\def\az@tmpr{#2}%
	\ifblank{#3}{}{\eqn@shift{l}{#3}}%
	\ifblank{#4}{}{\eqn@shift{r}{#4}}%
	\ifstrequal{#5}{@}
		{}
		{%
			\ifblank{#5}
				{\let\eqnframecmd\az@deco@formula}
				{%
					\ifcsundef{az@deco@#5}
						{\azframe@err{#5}}
						{\letcs\eqnframecmd{az@deco@#5}}%
				}%
		}%
	\ifis@result%
		\textmodetrue%
		\let\eqnframecmd\az@deco@result%
	\fi%
	\iftextmode%
		\ifblank{#7}{}{\def\minipage@wd{#7}}%
	\fi%
	\ifstrequal{#6}{@}
		{\let\@ligned\relax}
		{%
			\ifblank{#6}%
				{\def\@ligned{\aligned[t]}}%
				{\def\@ligned{\aligned[#6]}}%
		}%
	\ifstrequal{#8}{@}%
		{\def\Make@Link{}\def\az@tmplb{}}%
		{\label@parts{#8}}%
	\ifblank{#9}{}{\setlength\bigcenterskip{\bigcenterskip*\real{#9}}}%
	\xmath@process%
}
\long\def\xmath@process#1\end@xmath{%
	\ifx\relax\@ligned%
		\iftextmode%
			\long\def\az@tmpm{#1}%
		\else%
			\def\az@tmpm{$\m@th\displaystyle#1$}%
		\fi%
	\else%
		\def\az@tmpm{$\m@th\displaystyle\@ligned#1\endaligned$}%
	\fi%
	\@xp\@center@\@xp
		{\minipage@wd}
		{\az@tmpl}
		{\az@tmpm}
		{\az@tmpr}
		{\az@tmplb}%
}
