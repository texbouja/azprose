%% az-nb-colors.def — palette « nb » (noir et blanc)
%%
%% Portée de `nbcolors.tex` (cpgekit). Toutes les teintes nommées valent le même
%% gris très foncé (clair) ou très clair (sombre) : les blocs sémantiques ne se
%% distinguent alors plus que par leur libellé. Destinée à la photocopie, où
%% \azgeometry{print} ne suffit pas parce qu'il ne neutralise que la page.

\azsetupcolors
  {
    default import model = named,
    mainone         = [HTML]{000000},
    maintwo         = [HTML]{111111},
    mainthree       = [HTML]{eeeeee},
    mainfour        = [HTML]{ffffff},
    mainfive        = [HTML]{444444},
    mainsix         = [HTML]{aaaaaa},
    azgreen         = [HTML]{111111}{eeeeee},
    azyellow        = [HTML]{111111}{eeeeee},
    azblue          = [HTML]{111111}{eeeeee},
    azred           = [HTML]{111111}{eeeeee},
    azmagenta       = [HTML]{111111}{eeeeee},
    azorange        = [HTML]{111111}{eeeeee},
    azcyan          = [HTML]{111111}{eeeeee},
    pagecol         = {mainfour}{mainone},
    textcol         = {mainone}{mainfour},
    strokecol       = {maintwo}{mainthree},
    frametextcol    = {mainone}{mainfour},
    framestrokecol  = {mainfive}{mainsix},
    framebackcol    = {mainthree}{maintwo},
    frameshadowcol  = {black}{white},
    titletextcol    = {azorange}{azorange},
    titlestrokecol  = {gray}{gray},
    titlebackcol    = {gray}{gray},
    linktextcol     = {azblue}{azblue!75!blue!65!white},
    linkstrokecol   = {azblue}{azblue},
    linkbackcol     = {azblue}{azblue},
    buttontextcol   = {mainone}{mainone},
    buttonstrokecol = {azblue}{azblue},
    buttonbackcol   = {azblue}{azblue},
    importantcol    = {azorange}{azorange},
    alertcol        = {azred}{azred},
    azneutral       = {mainfive}{mainsix},
    errorcol        = {azcyan}{azcyan},
    theoremcol      = {azgreen}{azgreen},
    definitioncol   = {azblue}{azblue},
    remarkcol       = {azneutral}{azneutral},
    examplecol      = {azneutral}{azneutral},
    exercisecol     = {azorange}{azorange},
    class           = {azorange}{azyellow}{azgreen},
  }

\endinput
