%% azsolution.sty — solutions et démonstrations différées
%%
%% ⚠️ RECTIFICATION. Ce module a d'abord été présenté comme la fusion de deux
%% implémentations redondantes. C'était faux, et l'auteur du kit d'origine l'a
%% corrigé : cpgedoc et cpgedev ne faisaient PAS la même chose deux fois.
%%
%%   cpgedoc — \solution absorbe jusqu'à la fin de l'environnement ; le corps
%%             part dans un fichier PAR BLOC, désigné par le compteur de
%%             l'environnement, et une entrée s'ajoute à un registre relu plus
%%             tard ;
%%   cpgedev — un environnement {solution} AUTONOME ; le corps s'ajoute à un
%%             fichier COMMUN à tout l'exercice, et le numéro de la question
%%             part dans une liste de tokens.
%%
%% Deux conceptions distinctes, pas une duplication. L'isolement de ce module
%% ne peut donc pas se justifier par un partage entre classes.
%%
%% ── Ce qui le justifie ──────────────────────────────────────────────────────
%%
%% Le kit a maintenant DEUX moteurs de blocs — azthm sur tcolorbox, azbloc sur
%% framed+pgf — et le déport des solutions n'est propre ni à l'un ni à l'autre.
%% C'est une POLITIQUE : où va une solution, quand, et comment on y renvoie.
%% Le MÉCANISME, lui, dépend du moteur : détourner un corps, s'accrocher à un
%% bloc, dessiner une pastille de lien.
%%
%% Ce module tient la politique et ne connaît du mécanisme que des NOMS, liés
%% au chargement au moteur actif. Les deux jeux de liaisons vivent ici, en bas
%% de fichier : c'est le seul endroit du kit qui connaisse les deux moteurs, et
%% c'est ce qui permet à azthm et azbloc de tout ignorer des solutions.
%%
%% Le module est par ailleurs paramétré par le GENRE — `solution` ou `proof` —
%% qui se comportent mot pour mot pareil ; seuls changent leur nom, le préfixe
%% de leurs fichiers et la section qui les rassemble.
%%
%% ── Les trois placements ────────────────────────────────────────────────────
%%
%%   SUR PLACE   la solution suit son énoncé, dans la même boîte ;
%%   DIFFÉRÉ     elle est mise de côté et sort en fin de fragment, précédée
%%               d'un titre de section ;
%%   PLACÉ       elle est mise de côté et n'apparaît qu'où le rédacteur écrit
%%               \solutions — fin de volume, annexe, ou nulle part.
%%
%% Le rédacteur écrit la même chose dans les trois cas. Ce qui change est une
%% option de classe, et c'est tout le propos : la place d'une solution est une
%% décision de TIRAGE, pas de rédaction.
%%
%% ── Comment ─────────────────────────────────────────────────────────────────
%%
%% Le corps de la solution est DÉTOURNÉ vers un fichier — par `savelowerto`
%% avec azthm, par \azwriteonce avec azbloc, et ce module ne sait pas lequel.
%% Une commande de REJEU — \solu ou \preuve — portant tout ce qu'il faut pour
%% reconstruire titre, lien et étiquette, est soit exécutée aussitôt, soit
%% accumulée puis déposée au carnet de azrecord, relu à la compilation
%% suivante.
%%
%% Sadik Boujaida — licence LPPL 1.3c

\NeedsTeXFormat{LaTeX2e}[2022/06/01]
\ProvidesExplPackage {azsolution} {2026-08-20} {0.1}
  {azkit — solutions et démonstrations, sur place ou différées}

\RequirePackage { azbase }
\RequirePackage { azrecord }

%% AUCUN moteur n'est chargé ici : c'est l'appelant qui en a choisi un, et ce
%% module se lie à celui qu'il trouve. Le charger reviendrait à imposer
%% tcolorbox à un document qui l'a précisément écarté.

\cs_if_exist:NF \ifdraft   { \newif \ifdraft }
\cs_if_exist:NF \ifprint   { \newif \ifprint }
\cs_if_exist:NF \ifcompact { \newif \ifcompact }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Les deux genres
%%
%% Toute la suite est écrite pour un genre quelconque. Les seules données qui
%% les distinguent tiennent dans cette table.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%% Dossier des corps mis de cote. Declare avant les cles, qui l'affectent.
%% azbloc en pose un aussi, faute de quoi il ne saurait ou ecrire seul : on ne
%% le redeclare donc pas, on s'en sert.
\cs_if_exist:NF \azauxdir
  { \tl_new:N \azauxdir \tl_set:Nn \azauxdir { tmp } }

\clist_const:Nn \c_az_sol_genres_clist { solution, proof }

\prop_const_from_keyval:Nn \c_az_sol_prefixe_prop { solution = sol , proof = prv }

\cs_new:Npn \az_sol_prefixe:n #1 { \prop_item:Nn \c_az_sol_prefixe_prop {#1} }

\clist_map_inline:Nn \c_az_sol_genres_clist
  {
    \bool_new:c { g_az_ #1 _on_bool }
    \bool_new:c { g_az_ #1 _delayed_bool }
    \tl_new:c   { g_az_ #1 _buffer_tl }
    \tl_new:c   { g_az_ #1 _section_tl }
    \tl_new:c   { g_az_ #1 _title_tl }
    \tl_new:c   { l_az_ #1 _replay_tl }
  }

\tl_gset:cn { g_az_solution_section_tl } { \section }
\tl_gset:cn { g_az_solution_title_tl }   { Solutions~des~exercices }
\tl_gset:cn { g_az_proof_section_tl }    { \section }
\tl_gset:cn { g_az_proof_title_tl }      { Démonstrations~des~résultats }

%% \NewDocumentCommand et non \newrobustcmd : etoolbox arrivait par tcolorbox,
%% que ce module ne charge plus.
\cs_if_exist:NF \solutionname
  { \NewDocumentCommand \solutionname { } { solution } }
\cs_if_exist:NF \proofname
  { \NewDocumentCommand \proofname { } { démonstration } }

\cs_new:Npn \solutionautorefname { \solutionname }
\cs_new:Npn \proofautorefname    { \proofname }

%% Drapeaux hérités, tenus en phase avec les booléens : le CONTENU les consulte
%% (« \ifsolution … \fi » se rencontre dans les documents), le kit ne lit que
%% les booléens.
\cs_if_exist:NF \ifsolution        { \newif \ifsolution }
\cs_if_exist:NF \ifsolutiondelayed { \newif \ifsolutiondelayed }
\cs_if_exist:NF \ifproof           { \newif \ifproof }
\cs_if_exist:NF \ifproofdelayed    { \newif \ifproofdelayed }

\cs_new_protected:Npn \az_sol_flags_sync:
  {
    \bool_if:cTF { g_az_solution_on_bool } { \global\solutiontrue } { \global\solutionfalse }
    \bool_if:cTF { g_az_solution_delayed_bool }
      { \global\solutiondelayedtrue } { \global\solutiondelayedfalse }
    \bool_if:cTF { g_az_proof_on_bool } { \global\prooftrue } { \global\prooffalse }
    \bool_if:cTF { g_az_proof_delayed_bool }
      { \global\proofdelayedtrue } { \global\proofdelayedfalse }
  }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% LE JOINT
%%
%% Sept noms, et l'identité du bloc courant. C'est tout ce que ce module
%% connaît du moteur de blocs ; les liaisons vers le vrai travail sont posées
%% en bas de fichier, selon celui qui est chargé.
%%
%% Aucun de ces noms n'a d'implémentation ici : sans moteur, la première
%% solution rencontrée le dit clairement plutôt que d'échouer obscurément
%% quinze appels plus loin.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\msg_new:nnnn { azkit } { sol-sans-moteur }
  { Aucun~moteur~de~blocs~pour~les~solutions. }
  {
    azsolution~se~lie~à~azthm~ou~à~azbloc,~et~n'en~charge~aucun~lui-même.~
    Charger~l'un~des~deux~AVANT~lui.
  }

%% L'identité du bloc courant, renseignée par la liaison `arm` du moteur.
%% Le relevé ne lit que ces cinq variables — c'est ce qui le rend indépendant.
\tl_new:N \l_az_sol_env_tl     % le genre du bloc : theo, exer…
\tl_new:N \l_az_sol_num_tl     % son numéro composé
\tl_new:N \l_az_sol_key_tl     % la clef de renvoi
\tl_new:N \l_az_sol_name_tl    % le nom préfixé : « de l'exercice »
\tl_new:N \l_az_sol_desc_tl    % l'intitulé

%% Quel moteur est là ? Décidé une fois, au chargement.
\bool_new:N \g_az_sol_thm_bool
\bool_new:N \g_az_sol_bloc_bool
\@ifpackageloaded { azthm }  { \bool_gset_true:N \g_az_sol_thm_bool }  { }
\@ifpackageloaded { azbloc } { \bool_gset_true:N \g_az_sol_bloc_bool } { }

\cs_new_protected:Npn \az_sol_no_engine:
  { \msg_error:nn { azkit } { sol-sans-moteur } }

%% Déclarer qu'un GENRE de bloc porte une solution. Reçoit le genre de solution.
\cs_new_protected:Npn \az_sol_do_attach:n     #1 { \az_sol_no_engine: }
%% À l'ouverture d'un bloc : publier l'identité et armer \solution / \proof.
\cs_new_protected:Npn \az_sol_do_arm:n        #1 { \az_sol_no_engine: }
%% Détourner le reste du corps vers le fichier nommé.
\cs_new_protected:Npn \az_sol_do_divert:n     #1 { \az_sol_no_engine: }
%% Clore le détournement.
\cs_new_protected:Npn \az_sol_do_divert_end:     { }
%% La pastille sous l'énoncé, qui mène à la solution.
\cs_new_protected:Npn \az_sol_do_linkdown:nn #1#2 { }
%% Le sous-titre sur place, en brouillon ou en placement immédiat.
\cs_new_protected:Npn \az_sol_do_subtitle:n   #1 { }

%% Le bandeau de tête du rejeu. Étoilé = sans lien ni ancre (brouillon).
\NewDocumentCommand \az_sol_do_linkup:w { s m m m m m m } { }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Réglages
%%
%%   solution        les solutions sortent sur place
%%   solution*       les solutions sont mises de côté
%%   solution section = {\chapter}{Corrigés}
%%
%% Différer IMPLIQUE produire : demander `solution*` sans `solution` serait
%% mettre de côté ce qu'on a choisi de ne pas composer.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\keys_define:nn { az / solution }
  {
    solution      .code:n =
      { \az_sol_mode:nn { solution } {#1} } ,
    solution      .default:n = { true } ,
    solution*     .code:n =
      { \bool_gset_true:c { g_az_solution_on_bool }
        \bool_gset_true:c { g_az_solution_delayed_bool } } ,
    proof         .code:n =
      { \az_sol_mode:nn { proof } {#1} } ,
    proof         .default:n = { true } ,
    proof*        .code:n =
      { \bool_gset_true:c { g_az_proof_on_bool }
        \bool_gset_true:c { g_az_proof_delayed_bool } } ,
    solution~section .code:n = { \az_sol_section:nw { solution } #1 \q_stop } ,
    proof~section    .code:n = { \az_sol_section:nw { proof } #1 \q_stop } ,
    before~solutions .tl_gset:N = \g_az_sol_hook_tl ,
    aux~dir       .tl_set:N = \azauxdir ,
    unknown       .code:n = { } ,
  }

\cs_new_protected:Npn \az_sol_mode:nn #1#2
  {
    \str_if_eq:nnTF {#2} { false }
      { \bool_gset_false:c { g_az_ #1 _on_bool } }
      { \bool_gset_true:c  { g_az_ #1 _on_bool } }
    %% Poser `solution` après `solution*` remet le placement SUR PLACE : la
    %% forme nue est la plus explicite des deux, elle l'emporte.
    \bool_gset_false:c { g_az_ #1 _delayed_bool }
  }

\cs_new_protected:Npn \az_sol_section:nw #1#2#3 \q_stop
  {
    \tl_gset:cn { g_az_ #1 _section_tl } {#2}
    \tl_gset:cn { g_az_ #1 _title_tl }   {#3}
  }

\NewDocumentCommand \azsetupsolutions { m } { \keys_set:nn { az / solution } {#1} }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Dossier de travail
%%
%% Un corps mis de côté est un fichier, un par bloc. Ils atterrissent dans un
%% sous-dossier pour ne pas noyer celui du document — un chapitre de cinquante
%% exercices en produit cinquante.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%% \openout ne crée pas le dossier. On tente un mkdir quand l'échappement vers
%% le shell est ouvert ; sinon c'est à la chaîne de compilation de l'avoir
%% préparé — latexmk le fait avec -auxdir.
\AddToHook { begindocument/before }
  {
    \sys_if_shell_unrestricted:T
      { \sys_shell_now:x { mkdir ~ -p ~ \azauxdir } }
  }


%% ── LIAISON azthm ─────────────────────────────────────────────────────────
%% Tout ce qui suit ne vaut que pour le moteur tcolorbox.
\bool_if:NT \g_az_sol_thm_bool {
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Liens entre énoncé et solution
%%
%% Une solution différée est LOIN de son énoncé : sans lien dans les deux sens,
%% le document devient impraticable à l'écran. D'où deux attaches — une pastille
%% sous l'énoncé qui mène à la solution, un bandeau au-dessus de la solution qui
%% ramène à l'énoncé.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\tl_new:N \az@sol@labelkey
\tl_new:N \az@sol@counter

\tcbset
  {
    demolink/.style = { } ,
    az@demolink/.style~n~args = {3}
      {
        size = #1 , arc = #2 , demolink , colframe = linkstrokecol , #3 ,
      } ,
    az@demolink@colors/.style = { coltext = white , colback = linkbackcol } ,
  }

%% À l'impression il n'y a pas d'hyperlien à suggérer : la pastille redevient
%% une simple mention, encadrée mais pas remplie.
\AddToHook { begindocument/before }
  {
    \ifprint
      \tcbset { az@demolink@colors/.style =
        { coltext = linktextcol , colback = pagecol } }
    \fi
  }

\cs_new_protected:Npn \az_sol_link_down:nn #1#2
  {
    \par \nopagebreak \vskip -\baselineskip
    \vbox to \c_zero_dim
      {
        \null \hfill
        \tcbox
          [
            enhanced, nobeforeafter,
            az@demolink = {tight}{\c_zero_dim}
              { az@demolink@colors, top = .25ex, bottom = .25ex } ,
            hyperlink = { #1 @ \thetcbcounter } ,
          ]
          {
            \sffamily \footnotesize \scshape \vphantom{(} \enskip
            #2 ~ \ref* { #1 : \az@sol@labelkey } ,~
            page ~ \pageref* { #1 : \az@sol@labelkey }
            \enskip \null
          }
      }
  }

%% Bandeau de tête de la solution rejouée. La forme étoilée est celle du mode
%% brouillon : ni lien ni ancre, juste le titre.
\NewDocumentCommand \az_sol_link_up:w { s m m m m m m }
  % #2 envname, #3 numéro, #4 nom préfixé, #5 genre, #6 nom du genre, #7 intitulé
  {
    \breakifnospace [4]
    \@hangfrom
      {
        \IfBooleanTF {#1}
          {
            \tcbox
              [
                enhanced, tcbox~raise~base,
                enlarge~left~by = -1em, left = 6pt, right = 6pt,
                az@demolink = {small}{8pt}
                  { colframe = strokecol, colback = pagecol, coltext = textcol } ,
              ]
              { \sffamily \scshape \small \vphantom{)} \enskip
                #6 ~ #4 ~ #3 \enskip \null }
          }
          {
            \tcbox
              [
                enhanced, tcbox~raise~base,
                enlarge~left~by = -1em, left = 6pt, right = 6pt,
                az@demolink = {small}{0.75em}{ az@demolink@colors } ,
                hyperlink = { #2 @ #3 } ,
                hypertarget = { #5 @ #3 } ,
              ]
              { \sffamily \scshape \small \vphantom{)} \enskip
                #6 ~ #4 ~ #3 \enskip \null }
          }
        \enskip
      }
    \IfBooleanF {#1}
      {
        \tl_if_blank:nF {#7} { ( { \scshape \footnotesize #7 } ) }
        \tl_set:Nx \@currentlabel {#3}
        \tl_if_blank:nF {#7} { \tl_set:Nx \@currentlabelname { \exp_not:n {#7} } }
        \label { #5 : \az@sol@labelkey }
      }
    \vrule width \c_zero_dim depth \bigskipamount
    \par \penalty \@M
  }

}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Le rejeu
%%
%% \solu et \preuve sont les commandes ÉCRITES AU CARNET. Elles portent tout ce
%% qu'il faut pour se recomposer seules, puisqu'elles seront relues ailleurs
%% dans le document — voire à la compilation suivante.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\cs_new_protected:Npn \az_sol_replay:nnnnnnn #1#2#3#4#5#6#7
  % #1 genre, #2 envname, #3 numéro, #4 étiquette, #5 nom préfixé,
  % #6 intitulé, #7 fichier
  {
    \begin { trivlist }
      %% La clef de renvoi vient de la commande de rejeu, pas de l'état courant :
      %% au moment ou l'on rejoue, le bloc d'origine est loin derriere.
      \tl_set:Nn \l_az_sol_key_tl {#4}
      \tl_set:Nn \l_az_sol_num_tl {#3}
      \cs_if_exist:NT \az@sol@labelkey { \tl_set:Nn \az@sol@labelkey {#4} }
      \item [ ]
      \ifdraft
        \az_sol_do_linkup:w * {#2}{#3}{#5}{#1}{ \use:c { #1 name } }{#6}
      \else
        \az_sol_do_linkup:w   {#2}{#3}{#5}{#1}{ \use:c { #1 name } }{#6}
      \fi
      \az_current_counter_set:n {#3}
      \az_liste_defaults_inside:
      \input {#7}
      \exit
      \closeunite
    \end { trivlist }
  }

%% Le carnet est relu une fois par genre : chaque passe doit ignorer ce qui ne
%% la concerne pas, d'où un rejeu neutre de même signature.
\NewDocumentCommand \az_sol_gobble:w { m m m m m m } { }

\NewDocumentCommand \solu   { m m m m m m }
  { \az_sol_replay:nnnnnnn { solution } {#1}{#2}{#3}{#4}{#5}{#6} }
\NewDocumentCommand \preuve { m m m m m m }
  { \az_sol_replay:nnnnnnn { proof } {#1}{#2}{#3}{#4}{#5}{#6} }

\cs_new_eq:NN \az@solu@live \solu
\cs_new_eq:NN \az@preuve@live \preuve

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Relevé
%%
%% Appelé au moment où la partie basse du bloc part dans son fichier. Il
%% construit la commande de rejeu ; selon le placement, il la joue tout de
%% suite ou la met en réserve.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\cs_new_protected:Npn \az_sol_record:n #1
  {
    \tl_set:cx { l_az_ #1 _replay_tl }
      {
        \exp_not:c { \az_sol_cmdname:n {#1} }
          { \l_az_sol_env_tl } { \l_az_sol_num_tl } { \l_az_sol_key_tl }
          { \l_az_sol_name_tl } { \l_az_sol_desc_tl }
          { \azauxdir / \az_sol_prefixe:n {#1} - \l_az_sol_num_tl }
      }
    \bool_if:cTF { g_az_ #1 _delayed_bool }
      {
        \tl_gput_right:cx { g_az_ #1 _buffer_tl }
          { ^^J \exp_not:v { l_az_ #1 _replay_tl } }
      }
      {
        %% Sur place : la commande est rangée sous le numéro du bloc et
        %% déclenchée juste après lui par la clé `after app`.
        \cs_gset:cpx { az@ #1 @imm@ \l_az_sol_num_tl }
          { \exp_not:v { l_az_ #1 _replay_tl } }
      }
  }

\cs_new:Npn \az_sol_cmdname:n #1
  { \str_case:nn {#1} { { solution } { solu } { proof } { preuve } } }

%% ── LIAISON azthm (suite) ─────────────────────────────────────────────────
\bool_if:NT \g_az_sol_thm_bool {
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Attache aux blocs
%%
%% `with solution` et `with proof` étaient définis vides par azthm : ils
%% prennent ici leur contenu. Un bloc qui les porte accepte \solution (resp.
%% \proof) dans son corps, et bascule tout ce qui suit en partie basse.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\tcbset
  {
    az@sol@attach/.code =
      {
        \tcbset
          {
            lowerbox = ignored ,
            before~upper~app = { \az_sol_arm:n {#1} } ,
            savelowerto =
              { \azauxdir / \az_sol_prefixe:n {#1} - \thetcbcounter .tex } ,
            after~app = { \use:c { az@ #1 @imm@ \az@sol@counter } } ,
          }
      } ,
    with~solution/.style = { az@sol@attach = solution } ,
    with~proof/.style    = { az@sol@attach = proof } ,
  }

%% L'étiquette du bloc sert de clef de renvoi. Absente, le numéro en tient lieu :
%% un exercice sans <étiquette> doit rester atteignable.
\cs_new_protected:Npn \az_sol_arm:n #1
  {
    \tl_set:Nx \az@sol@labelkey
      {
        \tl_if_empty:NTF \az@thm@label
          { \thetcbcounter } { \exp_not:V \az@thm@label }
      }
    \tl_gset:Nx \az@sol@counter { \thetcbcounter }
    %% L'identité publiée, que le relevé est le seul à lire. C'est ce qui lui
    %% permet d'ignorer lequel des deux moteurs l'a renseignée.
    \tl_set_eq:NN \l_az_sol_env_tl  \az@thm@envname
    \tl_set:Nx    \l_az_sol_num_tl  { \thetcbcounter }
    \tl_set_eq:NN \l_az_sol_key_tl  \az@sol@labelkey
    \tl_set_eq:NN \l_az_sol_name_tl \az@thm@prefixedname
    \tl_set_eq:NN \l_az_sol_desc_tl \az@thm@title
    %% Le relevé n'a lieu QUE si le genre est demandé. Sans cette garde, la
    %% partie basse était relevée et rejouée par `after app` quoi qu'il arrive :
    %% `solution=false` ne cachait rien, et un cours tiré sans corrigés les
    %% composait quand même. (Le second défaut du même symptôme était côté
    %% azdoc, où la valeur du drapeau n'était pas développée avant lecture.)
    \cs_set:cpn { \az_sol_inline:n {#1} }
      {
        \bool_if:cT { g_az_ #1 _on_bool }
          {
            \az_sol_do_linkdown:nn {#1} { \use:c { #1 name } }
            \az_sol_record:n {#1}
          }
        \tcblower
      }
  }

\cs_new:Npn \az_sol_inline:n #1
  { \str_case:nn {#1} { { solution } { solution } { proof } { proof } } }

%% En brouillon, rien n'est mis de côté : la solution devient un simple
%% sous-titre dans la boîte. C'est ce qui rend la relecture immédiate.
\cs_new_protected:Npn \az_sol_draft_block:n #1
  {
    \exit \closeunite
    \tcbsubtitle [ az@sol@subtitle ] { \use:c { #1 name } }
    \az_liste_defaults_inside:
  }

\tcbset
  {
    az@sol@subtitle/.style =
      {
        spartan, coltext = white, colback = thmcol, colbacktitle = thmcol,
        boxrule = 0pt, boxsep = 0pt, top = .8pt, bottom = .8pt,
      } ,
  }
}

\AddToHook { begindocument/before }
  {
    \ifdraft
      \tcbset { with~solution/.style = { } , with~proof/.style = { } }
      \cs_set:Npn \solution { \az_sol_draft_block:n { solution } }
      \cs_set:Npn \proof    { \az_sol_draft_block:n { proof } }
    \fi
    \az_sol_flags_sync:
    \az_sol_arm_record:
  }

%% Un placement différé ou placé demande un carnet : autant l'ouvrir dès le
%% départ, plutôt qu'au premier bloc rencontré.
\cs_new_protected:Npn \az_sol_arm_record:
  {
    \bool_lazy_or:nnT
      { \bool_if_p:c { g_az_solution_delayed_bool } }
      { \bool_if_p:c { g_az_proof_delayed_bool } }
      { \ifazrecordopen \else \azstartrecording \fi }
  }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Vidange
%%
%% Ce qui a été mis en réserve pendant un fragment part au carnet, précédé de
%% son titre de section. Le titre n'est écrit QUE si la réserve n'est pas vide :
%% un chapitre sans exercice ne doit pas hériter d'une section « Solutions »
%% vide.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\cs_new_protected:Npn \az_sol_flush:n #1
  {
    \bool_if:cT { g_az_ #1 _delayed_bool }
      {
        \tl_if_empty:cF { g_az_ #1 _buffer_tl }
          {
            \ifazrecordopen \else \azstartrecording \fi
            \use:x
              {
                \exp_not:N \azrecord
                  {
                    \exp_not:v { g_az_ #1 _section_tl }
                      { \exp_not:v { g_az_ #1 _title_tl } }
                  }
              }
            \use:x
              { \exp_not:N \azrecord { \exp_not:v { g_az_ #1 _buffer_tl } } }
            \tl_gclear:c { g_az_ #1 _buffer_tl }
          }
      }
  }

\cs_new_protected:Npn \az_sol_flush_all:
  { \clist_map_inline:Nn \c_az_sol_genres_clist { \az_sol_flush:n {##1} } }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Points de dépôt
%%
%% \solutions et \proofs relisent le carnet en ne laissant vivre que le genre
%% demandé. C'est ce qui permet d'écrire les deux à des endroits différents
%% alors qu'ils partagent un seul carnet.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\cs_new_protected:Npn \az_sol_emit:n #1
  {
    \bool_if:cT { g_az_ #1 _delayed_bool }
      {
        \az_sol_flush:n {#1}
        \azstoprecording
        %% L'autre genre est neutralisé le temps de la lecture, puis rendu.
        \clist_map_inline:Nn \c_az_sol_genres_clist
          {
            \str_if_eq:nnF {##1} {#1}
              {
                \cs_set_eq:cN { \az_sol_cmdname:n {##1} } \az_sol_gobble:w
              }
          }
        \g_az_sol_hook_tl
        \azreadrecord
        \clist_map_inline:Nn \c_az_sol_genres_clist
          {
            \cs_set_eq:cc { \az_sol_cmdname:n {##1} }
              { az@ \az_sol_cmdname:n {##1} @live }
          }
      }
  }

%% \Declare et non \New : azbloc en pose des versions muettes pour qu'un
%% document ecrit pour azthm compile sans ce module. Ici on les remplace.
\DeclareDocumentCommand \solutions { } { \az_sol_emit:n { solution } }
\DeclareDocumentCommand \proofs    { } { \az_sol_emit:n { proof } }


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Ce qui se passe quand le rédacteur écrit \solution
%%
%% La POLITIQUE, en un seul endroit : produire sur place, mettre de côté, ou
%% ne rien composer du tout. Le moteur n'intervient que par les trois noms du
%% joint appelés ici.
%%
%% ⚠️ Seule la liaison azbloc emprunte ce chemin pour l'instant. azthm garde
%% son \az_sol_arm:n historique, qui ne consulte PAS les drapeaux `solution` et
%% `proof` : un document qui ne les demande pas voit malgré tout ses corrigés
%% composés. Le défaut est réel et connu ; le corriger revient à faire passer
%% azthm par ici, ce qui change la sortie de tous les documents existants —
%% décision de l'utilisateur, en attente.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\bool_new:N \l_az_sol_diverted_bool

\cs_new_protected:Npn \az_sol_engage:n #1
  {
    \bool_if:cTF { g_az_ #1 _on_bool }
      {
        \bool_if:cTF { g_az_ #1 _delayed_bool }
          {
            \az_sol_do_linkdown:nn {#1} { \use:c { #1 name } }
            \az_sol_record:n {#1}
            %% Le drapeau AVANT le détournement : la capture verbatim est active
            %% dès l'appel, et tout ce qui suit partirait dans le fichier.
            \bool_set_true:N \l_az_sol_diverted_bool
            \az_sol_do_divert:n
              { \azauxdir / \az_sol_prefixe:n {#1} - \l_az_sol_num_tl }
          }
          { \az_sol_do_subtitle:n {#1} }
      }
      {
        %% Éteint : le corps part vers un fichier que personne ne relira. C'est
        %% le seul moyen de ne pas le composer sans le conditionner ligne à
        %% ligne dans la source.
        \bool_set_true:N \l_az_sol_diverted_bool
        \az_sol_do_divert:n { \azauxdir / az-rebut }
      }
  }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% LES LIAISONS
%%
%% Les sept noms du joint pointent ici vers le vrai travail. C'est le seul
%% endroit du kit qui connaisse les deux moteurs — et c'est ce qui permet à
%% azthm et à azbloc de tout ignorer des solutions.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\bool_if:NT \g_az_sol_thm_bool
  {
    %% azthm — tcolorbox fait presque tout : `savelowerto` détourne le corps
    %% dès que \tcblower est atteint, il n'y a donc rien à ouvrir ni à fermer.
    \cs_gset_protected:Npn \az_sol_do_attach:n #1
      { \tcbset { az@sol@attach = #1 } }
    \cs_gset_protected:Npn \az_sol_do_arm:n #1 { \az_sol_arm:n {#1} }
    \cs_gset_protected:Npn \az_sol_do_divert:n #1 { \tcblower }
    \cs_gset_protected:Npn \az_sol_do_divert_end: { }
    \cs_gset_protected:Npn \az_sol_do_linkdown:nn #1#2
      { \az_sol_link_down:nn {#1} {#2} }
    \cs_gset_protected:Npn \az_sol_do_subtitle:n #1
      { \az_sol_draft_block:n {#1} }
    \cs_gset_eq:NN \az_sol_do_linkup:w \az_sol_link_up:w
  }

\bool_if:NT \g_az_sol_bloc_bool
  {
    %% azbloc — rien n'est fait pour nous : il faut ouvrir la capture verbatim,
    %% la refermer, et dessiner les attaches. Elles suivent l'idiome du moteur —
    %% filet et petites capitales, aucune boîte — plutôt que d'imiter les
    %% pastilles de tcolorbox, qui y coûteraient ce qu'on est venu y gagner.
    \cs_gset_protected:Npn \az_sol_do_attach:n #1 { }
    \cs_gset_protected:Npn \az_sol_do_arm:n #1
      {
        \tl_set_eq:NN \l_az_sol_env_tl  \l_az_bloc_env_tl
        \tl_set_eq:NN \l_az_sol_num_tl  \l_az_bloc_num_tl
        \tl_set_eq:NN \l_az_sol_key_tl  \l_az_bloc_key_tl
        \tl_set_eq:NN \l_az_sol_name_tl \l_az_bloc_name_tl
        \tl_set_eq:NN \l_az_sol_desc_tl \l_az_bloc_desc_tl
      }
    %% Le drapeau de capture d'azbloc est posé au passage : c'est SA fin
    %% d'environnement qui referme le détournement, et elle le consulte.
    \cs_gset_protected:Npn \az_sol_do_divert:n #1
      { \bool_set_true:N \l__az_bloc_capturing_bool \azwriteonce {#1} }
    \cs_gset_protected:Npn \az_sol_do_divert_end:
      { \endazwriteonce }
    \cs_gset_protected:Npn \az_sol_do_subtitle:n #1
      { \az_bloc_subtitle:n {#1} }

    %% La pastille sous l'énoncé : une mention en bout de ligne, alignée à
    %% droite, cliquable. Pas de boîte — le bloc en est déjà une.
    \cs_gset_protected:Npn \az_sol_do_linkdown:nn #1#2
      {
        \par \nopagebreak \vskip -.4\baselineskip
        \hbox_to_wd:nn { \linewidth }
          {
            \hfill
            \hyperlink { #1 @ \l_az_sol_num_tl }
              {
                \color { linktextcol }
                \sffamily \scriptsize \scshape
                #2 ~ \ref* { #1 : \l_az_sol_key_tl } ,~
                p.~ \pageref* { #1 : \l_az_sol_key_tl }
              }
          }
        \par
      }

    %% Le bandeau de tête du rejeu : le sous-titre du moteur, suivi du renvoi
    %% vers l'énoncé. Étoilé — en brouillon — il perd son lien et son ancre.
    \RenewDocumentCommand \az_sol_do_linkup:w { s m m m m m m }
      % #2 envname, #3 numéro, #4 nom préfixé, #5 genre, #6 nom du genre, #7 intitulé
      {
        %% Le rejeu a lieu HORS du bloc : sa couleur d'accent n'existe plus.
        %% On la refait dire par azbloc à partir du genre, que la commande de
        %% rejeu porte justement pour cela.
        \exp_args:Nx \az_bloc_couleurs:n
          { \prop_item:Nn \g_az_bloc_type_prop {#2} }
        \IfBooleanF {#1}
          { \Hy@raisedlink { \hypertarget { #5 @ #3 } { } } }
        \noindent
        \begingroup
          \color { \l__az_bloc_accentcol_tl }
          \rule [ .3ex ] { 1.4em } { .8pt } \hspace { .5em }
          \azblocfonttitle \MakeUppercase {#6} \hspace { .35em }
          \IfBooleanTF {#1}
            { #4 ~ #3 }
            { \hyperlink { #2 @ #3 } { #4 ~ #3 } }
          \tl_if_blank:nF {#7}
            { \hspace { .6em } { \normalfont \itshape \footnotesize #7 } }
        \endgroup
        \IfBooleanF {#1}
          {
            \tl_set:Nx \@currentlabel {#3}
            \label { #5 : \l_az_sol_key_tl }
          }
        \par \nobreak \vspace { .3\azblocvsep }
      }

    %% \solution et \proof d'azbloc cèdent la place : c'est désormais ce module
    %% qui décide où va le corps.
    \cs_gset_protected:Npn \az_bloc_sol:n #1 { \az_sol_engage:n {#1} }
    \cs_gset_protected:Npn \az_bloc_sol_arm: { \az_sol_do_arm:n { } }
  }
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Raccord avec azinclude
%%
%% Un fragment inclus vide sa réserve à sa sortie : les solutions d'un chapitre
%% restent avec leur chapitre, même si elles sont composées plus loin.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\cs_if_exist:NT \azinclude
  {
    \tl_gput_right:Nn \g_az_include_after_tl { \az_sol_flush_all: }
    \keys_define:nn { az / include }
      {
        unknown .code:n =
          {
            \tl_if_novalue:nTF {#1}
              { \use:x { \exp_not:N \azsetupsolutions { \l_keys_key_str } } }
              { \use:x { \exp_not:N \azsetupsolutions
                  { \l_keys_key_str = { \exp_not:n {#1} } } } }
          } ,
      }
  }

\endinput
